run-command-6='<Shift><Mod4>XF86TouchpadOff'

[org/mate/marco/keybinding-commands]
command-1='orca --replace'
command-2='mate-terminal --title="Sona AI Assistant" -e /usr/local/bin/sona-ai'
command-3='/usr/local/bin/sona-ocr'
command-4='copyq toggle'
command-5='mate-terminal --title="Sona AI Assistant" -e /usr/local/bin/sona-ai'
command-6='mate-terminal --title="Sona AI Assistant" -e /usr/local/bin/sona-ai'
DCONF_SETTINGS

dconf update

# 13. Install yay and AUR packages (Chrome, Pamac, Thorium, RHVoice, OCR tools)
# AUR problems must never stop the install, so every step here is allowed to fail.
echo "%wheel ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/99-sona-temp-nopasswd
chmod 0440 /etc/sudoers.d/99-sona-temp-nopasswd
if su - "$USERNAME" -c "rm -rf /tmp/yay-bin && git clone https://aur.archlinux.org/yay-bin.git /tmp/yay-bin && cd /tmp/yay-bin && makepkg -si --noconfirm"; then
    for aur_pkg in google-chrome tgpt-bin pamac-aur thorium-reader-bin ocrmypdf lios-git abcde rhvoice; do
        su - "$USERNAME" -c "yay -S --noconfirm --needed $aur_pkg" || echo "Warning: AUR package $aur_pkg skipped."
    done
else
    echo "Warning: yay could not be installed, so AUR packages were skipped."
    echo "You can install them later with: yay -S google-chrome pamac-aur thorium-reader-bin"
fi
rm -rf /tmp/yay-bin
rm -f /etc/sudoers.d/99-sona-temp-nopasswd

# 14. Built-in Sona AI Assistant (Alt+Super+H / Copilot Key)
cat > /usr/local/bin/sona-ai << 'SONA_AI_SCRIPT'
#!/bin/bash
echo "====================================================="
echo " Welcome to the Sona Linux AI Assistant"
echo " Type any question about Sona Linux, MATE, or Orca."
echo " Type 'exit' or press Ctrl+C to close."
echo "====================================================="

SYS_PROMPT="You are the built-in helper for Sona Linux, an accessible Arch Linux distribution for blind users running the MATE desktop (configured in the Windows 2000 Redmond layout), XLibre, and the Orca screen reader. Pressing the Windows (Super) key or Alt+F1 opens the classic vertical Start menu. All main apps are also right on the Desktop (Alt+Ctrl+D): Google Chrome, Thunderbird Email (3-pane QuickMail layout using F6/Shift+F6), Add or Remove Software (Pamac), Word Processor (LibreOffice), Thorium Book Reader, VLC Media Player, Instant Screen OCR (Alt+Super+O), Clipboard History (Super+V), and System Restore (Timeshift). Keep answers concise, plain-text, and focused on keyboard shortcuts."

while true; do
    printf "\nAsk Sona: "
    read -r user_query
    if [[ -z "$user_query" ]]; then
        continue
    fi
    if [[ "${user_query,,}" == "exit" || "${user_query,,}" == "quit" ]]; then
        break
    fi
    echo "Thinking..."
    tgpt -q --preprompt "$SYS_PROMPT" "$user_query" 2>/dev/null || echo "Unable to reach AI service. Check your internet connection."
done
SONA_AI_SCRIPT
chmod +x /usr/local/bin/sona-ai

cat > /usr/share/applications/sona-ai.desktop << SONA_AI_DESKTOP
[Desktop Entry]
Type=Application
Name=Sona AI Assistant
Comment=Ask questions and get help using Sona Linux
Exec=mate-terminal --title="Sona AI Assistant" -e /usr/local/bin/sona-ai
Icon=utilities-terminal
Terminal=false
Categories=Utility;Accessibility;
SONA_AI_DESKTOP

# 15. NVDA-Style Instant Window OCR Tool (Alt+Super+O)
cat > /usr/local/bin/sona-ocr << 'SONA_OCR_SCRIPT'
#!/bin/bash
spd-say "Recognizing window, please wait" 2>/dev/null || true
TMP_IMG=$(mktemp /tmp/sona-ocr-XXXXXX.png)
TMP_TXT=$(mktemp /tmp/sona-ocr-XXXXXX.txt)

ACTIVE_WIN=$(xdotool getactivewindow 2>/dev/null || true)
if [[ -n "$ACTIVE_WIN" ]]; then
    maim --window "$ACTIVE_WIN" "$TMP_IMG" 2>/dev/null || maim "$TMP_IMG"
else
    maim "$TMP_IMG"
fi

tesseract "$TMP_IMG" stdout -l eng 2>/dev/null > "$TMP_TXT" || true

if [[ -s "$TMP_TXT" ]]; then
    xclip -selection clipboard < "$TMP_TXT" 2>/dev/null || true
    zenity --text-info --title="Sona Instant OCR (Copied to Clipboard - Press Escape to Close)" --width=700 --height=500 --filename="$TMP_TXT" 2>/dev/null || true
else
    spd-say "No text recognized in the current window" 2>/dev/null || true
    zenity --info --title="Sona Instant OCR" --text="No readable text was detected in the current window." 2>/dev/null || true
fi

rm -f "$TMP_IMG" "$TMP_TXT"
SONA_OCR_SCRIPT
chmod +x /usr/local/bin/sona-ocr

cat > /usr/share/applications/sona-ocr.desktop << SONA_OCR_DESKTOP
[Desktop Entry]
Type=Application
Name=Instant Screen OCR
Comment=Recognize text in the active window and read it with Orca
Exec=/usr/local/bin/sona-ocr
Icon=scanner
Terminal=false
Categories=Utility;Accessibility;
SONA_OCR_DESKTOP

# 16. Populate Desktop Icons for User and /etc/skel (Ready for Live ISO too)
create_desktop_shortcuts() {
    local target_dir="$1"
    mkdir -p "$target_dir"

    cat > "$target_dir/Google Chrome.desktop" << 'EOF_ICON'
[Desktop Entry]
Type=Application
Name=Google Chrome
Comment=Browse the web
Exec=google-chrome-stable %U
Icon=google-chrome
Terminal=false
EOF_ICON

    cat > "$target_dir/Thunderbird Email.desktop" << 'EOF_ICON'
[Desktop Entry]
Type=Application
Name=Thunderbird Email
Comment=Read and send email
Exec=thunderbird %u
Icon=thunderbird
Terminal=false
EOF_ICON

    cat > "$target_dir/Add or Remove Software.desktop" << 'EOF_ICON'
[Desktop Entry]
Type=Application
Name=Add or Remove Software
Comment=Install, update, and search for applications
Exec=pamac-manager
Icon=system-software-install
Terminal=false
EOF_ICON

    cat > "$target_dir/Sona AI Assistant.desktop" << 'EOF_ICON'
[Desktop Entry]
Type=Application
Name=Sona AI Assistant
Comment=Ask questions about Sona Linux and Orca shortcuts (Alt+Super+H)
Exec=mate-terminal --title="Sona AI Assistant" -e /usr/local/bin/sona-ai
Icon=utilities-terminal
Terminal=false
EOF_ICON

    cat > "$target_dir/Instant Screen OCR.desktop" << 'EOF_ICON'
[Desktop Entry]
Type=Application
Name=Instant Screen OCR
Comment=Read text from inaccessible images or windows (Alt+Super+O)
Exec=/usr/local/bin/sona-ocr
Icon=scanner
Terminal=false
EOF_ICON

    cat > "$target_dir/Word Processor.desktop" << 'EOF_ICON'
[Desktop Entry]
Type=Application
Name=Word Processor
Comment=Create and edit documents with LibreOffice Writer
Exec=libreoffice --writer %U
Icon=libreoffice-writer
Terminal=false
EOF_ICON

    cat > "$target_dir/Spreadsheet.desktop" << 'EOF_ICON'
[Desktop Entry]
Type=Application
Name=Spreadsheet
Comment=Create and edit spreadsheets with LibreOffice Calc
Exec=libreoffice --calc %U
Icon=libreoffice-calc
Terminal=false
EOF_ICON

    cat > "$target_dir/Thorium Book Reader.desktop" << 'EOF_ICON'
[Desktop Entry]
Type=Application
Name=Thorium Book Reader
Comment=Read BARD, Bookshare, DAISY, and EPUB books
Exec=thorium-reader %U
Icon=thorium-reader
Terminal=false
EOF_ICON

    cat > "$target_dir/OCR Document Scanner (LIOS).desktop" << 'EOF_ICON'
[Desktop Entry]
Type=Application
Name=OCR Document Scanner (LIOS)
Comment=Scan paper documents and PDFs into readable text
Exec=lios
Icon=scanner
Terminal=false
EOF_ICON

    cat > "$target_dir/VLC Media Player.desktop" << 'EOF_ICON'
[Desktop Entry]
Type=Application
Name=VLC Media Player
Comment=Play audio and video files
Exec=vlc %U
Icon=vlc
Terminal=false
EOF_ICON

    cat > "$target_dir/CD Ripper.desktop" << 'EOF_ICON'
[Desktop Entry]
Type=Application
Name=CD Ripper
Comment=Rip audio CDs with Sound Juicer
Exec=sound-juicer %u
Icon=org.gnome.SoundJuicer
Terminal=false
EOF_ICON

    cat > "$target_dir/Sound and Volume Control.desktop" << 'EOF_ICON'
[Desktop Entry]
Type=Application
Name=Sound and Volume Control
Comment=Adjust speaker, headphone, and microphone levels
Exec=pavucontrol
Icon=multimedia-volume-control
Terminal=false
EOF_ICON

    cat > "$target_dir/Bluetooth Devices.desktop" << 'EOF_ICON'
[Desktop Entry]
Type=Application
Name=Bluetooth Devices
Comment=Pair and manage Bluetooth speakers, headphones, and keyboards
Exec=blueman-manager
Icon=bluetooth
Terminal=false
EOF_ICON

    cat > "$target_dir/System Restore (Timeshift).desktop" << 'EOF_ICON'
[Desktop Entry]
Type=Application
Name=System Restore (Timeshift)
Comment=Create or restore system backup snapshots
Exec=timeshift-launcher
Icon=timeshift
Terminal=false
EOF_ICON

    chmod +x "$target_dir"/*.desktop
}

create_desktop_shortcuts "/home/$USERNAME/Desktop"
create_desktop_shortcuts "/etc/skel/Desktop"

# 17. Set Google Chrome and Thunderbird as default applications
mkdir -p /etc/xdg "/home/$USERNAME/.config"
cat > /etc/xdg/mimeapps.list << MIMEAPPS
[Default Applications]
text/html=google-chrome.desktop
x-scheme-handler/http=google-chrome.desktop
x-scheme-handler/https=google-chrome.desktop
x-scheme-handler/about=google-chrome.desktop
x-scheme-handler/unknown=google-chrome.desktop
x-scheme-handler/mailto=thunderbird.desktop
message/rfc822=thunderbird.desktop

[Added Associations]
text/html=google-chrome.desktop;
x-scheme-handler/http=google-chrome.desktop;
x-scheme-handler/https=google-chrome.desktop;
x-scheme-handler/mailto=thunderbird.desktop;
message/rfc822=thunderbird.desktop;
MIMEAPPS

cp /etc/xdg/mimeapps.list "/home/$USERNAME/.config/mimeapps.list"

# 18. Autostart Orca, CopyQ, Desktop Icon Trust Helper, and Login Sound
cat > /usr/local/bin/sona-session-init << 'SESSION_INIT'
#!/bin/bash
for f in "$HOME"/Desktop/*.desktop; do
    [[ -f "$f" ]] || continue
    chmod +x "$f" 2>/dev/null || true
    gio set "$f" metadata::trusted true 2>/dev/null || true
done
paplay /usr/share/sounds/freedesktop/stereo/service-login.oga 2>/dev/null &
SESSION_INIT
chmod +x /usr/local/bin/sona-session-init

mkdir -p "/home/$USERNAME/.config/autostart" /etc/skel/.config/autostart

cat > "/home/$USERNAME/.config/autostart/orca.desktop" << DESKTOP
[Desktop Entry]
Type=Application
Name=Orca
Exec=orca
X-GNOME-Autostart-enabled=true
OnlyShowIn=MATE;
DESKTOP

cat > "/home/$USERNAME/.config/autostart/copyq.desktop" << DESKTOP
[Desktop Entry]
Type=Application
Name=CopyQ Clipboard History
Exec=copyq
X-GNOME-Autostart-enabled=true
OnlyShowIn=MATE;
DESKTOP

cat > "/home/$USERNAME/.config/autostart/sona-session-init.desktop" << DESKTOP
[Desktop Entry]
Type=Application
Name=Sona Desktop Session Init
Exec=/usr/local/bin/sona-session-init
X-GNOME-Autostart-enabled=true
OnlyShowIn=MATE;
DESKTOP

cp "/home/$USERNAME/.config/autostart/"*.desktop /etc/skel/.config/autostart/
chown -R "$USERNAME:$USERNAME" "/home/$USERNAME"

# 19. Refresh the boot menu now that everything is installed, so it also
# lists Windows or other systems found by os-prober. GRUB itself was
# installed earlier, so a failure here still leaves a bootable system.
grub-mkconfig -o /boot/grub/grub.cfg || echo "Warning: could not refresh the GRUB menu. Run grub-mkconfig -o /boot/grub/grub.cfg after reboot."
EOF

chmod +x /mnt/root/setup-chroot.sh

echo "Configuring Sona Linux inside chroot..."
arch-chroot /mnt /root/setup-chroot.sh

rm -f /mnt/root/setup-chroot.sh /mnt/root/install.conf

umount -R /mnt
MOUNTED=false

ui_msg "Installation Complete" "Sona Linux has been installed! Remove your installation media and press Enter to reboot."
reboot

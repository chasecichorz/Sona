#!/bin/bash
# Sona Linux Installer
# Accessible Arch Linux + SonicDE + XLibre with Debian-style TUI
#
# Run as root from an Arch Linux live ISO (or the Sona live ISO).
# Works on both UEFI and legacy BIOS computers.
#
# Usage:
#   Install                          ask every question with menus
#   Install --unattended FILE        install with no questions, using the
#                                    answers in FILE (see
#                                    examples/unattended-answers.conf)

set -Eeuo pipefail

BACKTITLE="Sona Linux Accessible Installer"
SELECTED_SSID=""
WIFI_PASS=""
MOUNTED=false
UNATTENDED=no
ANSWER_FILE=""
declare -A ANS=()

# BEGIN SONA PACKAGES
# Every package Sona installs. scripts/build-iso.sh reads this block too, so
# the live ISO always holds everything an installed system gets, and the
# installer can copy it to the disk with no internet.
SONA_BASE_PKGS=(
    base base-devel linux linux-headers linux-firmware sof-firmware
    alsa-ucm-conf sudo git curl wget nano zram-generator pacman-contrib
    networkmanager bluez bluez-utils grub efibootmgr os-prober
    espeakup espeak-ng speech-dispatcher orca brltty alsa-utils
    pipewire pipewire-pulse pipewire-alsa pipewire-jack wireplumber
    libcanberra sound-theme-freedesktop xdg-user-dirs xdg-utils
)
# CPU microcode: the installer picks one; the ISO carries both.
# shellcheck disable=SC2034  # read by scripts/build-iso.sh
SONA_UCODE_PKGS=(amd-ucode intel-ucode)
# The X server (XLibre) and the SonicDE desktop.
SONA_X_PKGS=(xlibre-meta mesa xorg-xinit)
SONA_DESKTOP_PKGS=(sonicde-meta dconf pciutils)
# Apps. A missing one is skipped with a warning instead of stopping the install.
SONA_APP_PKGS=(
    terminator kate ark okular gwenview kcalc firefox flatpak wine
    festival festival-us tesseract tesseract-data-eng poppler simple-scan
    maim xdotool xclip sox pavucontrol vlc mpv ffmpeg
    gst-plugins-good gst-plugins-bad gst-plugins-ugly gst-libav
    sound-juicer yt-dlp libreoffice-fresh hunspell hunspell-en_us
    thunderbird ntfs-3g exfatprogs gvfs gvfs-mtp gvfs-smb 7zip unzip unrar
    cups system-config-printer avahi nss-mdns sane sane-airscan timeshift
    cronie zenity
)
# What the Windows XP theme scripts need.
SONA_XP_PKGS=(sox python-dbus python-gobject gtk3 libgudev libnotify udisks2 gvfs-gphoto2)
# What the Kokoro neural voices need (python-pip only to fetch them when
# installing by download).
SONA_KOKORO_PKGS=(python-onnxruntime-cpu python-numpy python-soundfile python-pip libpulse)
# From the Stormux repository: screen reader support for Windows programs in Wine.
SONA_STORMUX_PKGS=(wine-access)
# NVIDIA driver (RTX 20 / GTX 16 and newer). On the ISO so it works with no
# internet; the installer removes it from computers that cannot use it.
SONA_NVIDIA_PKGS=(nvidia-open nvidia-utils nvidia-settings nvidia-prime)
# END SONA PACKAGES

case "${1:-}" in
    --unattended|--answers)
        [[ -n "${2:-}" ]] || { echo "Error: $1 needs the path to an answer file." >&2; exit 1; }
        UNATTENDED=yes
        ANSWER_FILE="$2"
        ;;
    -h|--help)
        sed -n '2,13p' "$0"
        exit 0
        ;;
    "")
        ;;
    *)
        echo "Error: unknown option $1. Run with --help for usage." >&2
        exit 1
        ;;
esac

# ---------------------------------------------------------------------------
# Error handling
# ---------------------------------------------------------------------------

# Progress and the install log.
# With menus (not unattended), the long, noisy steps write their output to
# LOG instead of the screen, and the screen shows one short status box that
# a screen reader can read: "Step 3 of 5: ...". Unattended installs (and the
# automated tests) still print everything, and also keep the log.
LOG=/var/log/sona-install.log
: > "$LOG" 2>/dev/null || LOG=/tmp/sona-install.log
QUIET=yes
STEP_NUM=0
STEP_TOTAL=5

# step TITLE [DETAIL]: start the next main step.
step() {
    STEP_NUM=$((STEP_NUM + 1))
    show_progress "$@"
}

# show_progress TITLE [DETAIL]: show the current step again with new detail.
show_progress() {
    local msg="Step $STEP_NUM of $STEP_TOTAL: $1"
    printf '\n== %s%s\n' "$msg" "${2:+ - $2}" >> "$LOG"
    if [[ "$QUIET" == yes ]]; then
        clear
        whiptail --backtitle "$BACKTITLE" --title "Installing Sona Linux" \
            --infobox "$msg

${2:-This can take a while.}

Details are saved in $LOG." 12 74
    else
        printf '\n== %s%s\n' "$msg" "${2:+ - $2}"
    fi
}

# quietly COMMAND...: run a noisy command, its output going to the log.
quietly() {
    if [[ "$QUIET" == yes ]]; then
        "$@" >> "$LOG" 2>&1
    else
        "$@" 2>&1 | tee -a "$LOG"
        return "${PIPESTATUS[0]}"
    fi
}

# Show what went wrong: the message and the end of the log.
show_failure() {
    local msg="$1"
    echo "Error: $msg" >> "$LOG"
    if [[ "$QUIET" == yes ]] && command -v whiptail >/dev/null 2>&1; then
        clear
        whiptail --backtitle "$BACKTITLE" --title "Installation Stopped" --scrolltext --msgbox "$msg

The last lines of the install log ($LOG) are below. Use the arrow keys to read them, then press Enter.

$(tail -n 25 "$LOG" 2>/dev/null)" 22 78 || true
        clear
    fi
    echo "Error: $msg" >&2
    echo "The full install log is in $LOG." >&2
}

# Exit code 130 means the user cancelled a dialog; that is not an error.
on_error() {
    local rc=$? line=$1
    if [[ $rc -eq 130 ]]; then
        exit 130
    fi
    show_failure "The installer stopped unexpectedly at line $line (exit code $rc)."
    if [[ "$MOUNTED" == true ]]; then
        # Never leave the saved passwords behind on the target disk.
        rm -f /mnt/root/install.conf /mnt/root/setup-chroot.sh 2>/dev/null || true
        umount -R /mnt 2>/dev/null || true
    fi
    exit "$rc"
}
trap 'on_error $LINENO' ERR

err() {
    show_failure "$1"
    if [[ "$MOUNTED" == true ]]; then
        # Never leave the saved passwords behind on the target disk.
        rm -f /mnt/root/install.conf /mnt/root/setup-chroot.sh 2>/dev/null || true
        umount -R /mnt 2>/dev/null || true
    fi
    exit 1
}

user_cancelled() {
    clear
    echo "Installer cancelled." >&2
    exit 130
}

# ---------------------------------------------------------------------------
# Dialog helpers
# Pressing Cancel or Escape in any input or menu quits the installer cleanly.
# ---------------------------------------------------------------------------

ui_msg() {
    if [[ "$UNATTENDED" == yes ]]; then
        printf '\n== %s\n%s\n' "$1" "$2"
        return 0
    fi
    whiptail --backtitle "$BACKTITLE" --title "$1" --msgbox "$2" 14 74
}

# ---------------------------------------------------------------------------
# Answer file (unattended mode)
# One KEY=value per line. Lines starting with # are comments. Values may be
# wrapped in single or double quotes. The file is read, never run.
# ---------------------------------------------------------------------------

ANSWER_KEYS=" DISK PART_MODE CONFIRM_ERASE ROOT_PART EFI_PART FULLNAME USERNAME PASSWORD ROOT_PASSWORD HOSTNAME TIMEZONE LANG_LOCALE CONSOLE_KEYMAP X11_KEYBOARD AUTOLOGIN XP_THEME INSTALL_METHOD WIFI_SSID WIFI_PASS INSTALL_AUR SERIAL_CONSOLE FINISH "

load_answers() {
    local file="$1" line key val n=0
    [[ -r "$file" ]] || err "Cannot read the answer file $file."
    while IFS= read -r line || [[ -n "$line" ]]; do
        n=$((n + 1))
        line="${line%$'\r'}"
        [[ -z "${line//[[:space:]]/}" || "$line" =~ ^[[:space:]]*# ]] && continue
        [[ "$line" == *=* ]] || err "Answer file line $n is not KEY=value: $line"
        key="${line%%=*}"
        key="${key//[[:space:]]/}"
        val="${line#*=}"
        if [[ ${#val} -ge 2 && ( ( "${val:0:1}" == '"' && "${val: -1}" == '"' ) || ( "${val:0:1}" == "'" && "${val: -1}" == "'" ) ) ]]; then
            val="${val:1:${#val}-2}"
        fi
        [[ "$ANSWER_KEYS" == *" $key "* ]] || err "Answer file line $n has an unknown setting: $key"
        ANS[$key]="$val"
    done < "$file"
}

# ans KEY [DEFAULT]: the answer for KEY, or DEFAULT when it is not set.
ans() {
    printf '%s' "${ANS[$1]:-${2:-}}"
}

ui_input() {
    local title="$1" prompt="$2" default="${3:-}" out
    if ! out=$(whiptail --backtitle "$BACKTITLE" --title "$title" --inputbox "$prompt" 10 74 "$default" 3>&1 1>&2 2>&3); then
        user_cancelled
    fi
    printf '%s' "$out"
}

ui_pass() {
    local title="$1" prompt="$2" out
    if ! out=$(whiptail --backtitle "$BACKTITLE" --title "$title" --passwordbox "$prompt" 10 74 3>&1 1>&2 2>&3); then
        user_cancelled
    fi
    printf '%s' "$out"
}

# ui_menu TITLE PROMPT TAG ITEM [TAG ITEM ...]
ui_menu() {
    local title="$1" prompt="$2" out
    shift 2
    if ! out=$(whiptail --backtitle "$BACKTITLE" --title "$title" --menu "$prompt" 20 76 10 "$@" 3>&1 1>&2 2>&3); then
        user_cancelled
    fi
    printf '%s' "$out"
}

# Prints y or n. Escape counts as n.
ui_yesno() {
    if whiptail --backtitle "$BACKTITLE" --title "$1" --yesno "$2" 12 74; then
        echo "y"
    else
        echo "n"
    fi
}

# Same as ui_yesno, but No is selected by default. Use for anything destructive.
# In unattended mode the answer file's CONFIRM_ERASE=yes (checked before any
# disk is touched) is the confirmation.
ui_yesno_default_no() {
    if [[ "$UNATTENDED" == yes ]]; then
        echo "y"
        return 0
    fi
    if whiptail --backtitle "$BACKTITLE" --title "$1" --defaultno --yesno "$2" 14 74; then
        echo "y"
    else
        echo "n"
    fi
}

# Partition device name: /dev/sda + 2 = /dev/sda2, /dev/nvme0n1 + 2 = /dev/nvme0n1p2
part_path() {
    local disk="$1" num="$2"
    if [[ "$disk" =~ [0-9]$ ]]; then
        echo "${disk}p${num}"
    else
        echo "${disk}${num}"
    fi
}

# lsblk_field KEY LINE: read one value from a line of `lsblk -P` output.
lsblk_field() {
    local re="(^|[[:space:]])$1=\"([^\"]*)\""
    if [[ "$2" =~ $re ]]; then
        printf '%s' "${BASH_REMATCH[2]}"
    fi
}

wait_for_device() {
    local dev="$1" tries=0
    while [[ ! -b "$dev" ]]; do
        tries=$((tries + 1))
        if [[ $tries -gt 20 ]]; then
            err "Partition $dev did not appear after partitioning."
        fi
        sleep 0.5
    done
}

# ---------------------------------------------------------------------------
# 1. Preflight checks
# ---------------------------------------------------------------------------

if [[ $EUID -ne 0 ]]; then
    err "This installer must be run as root."
fi

if [[ "$UNATTENDED" == yes ]]; then
    load_answers "$ANSWER_FILE"
    echo "Unattended install using $ANSWER_FILE"
    QUIET=no
fi

# The stock Arch ISO does not include whiptail (package libnewt).
# Unattended installs never show menus, so they do not need it.
if [[ "$UNATTENDED" != yes ]] && ! command -v whiptail >/dev/null 2>&1; then
    echo "Installing whiptail for the installer menus..."
    if ! pacman -Sy --noconfirm --needed libnewt; then
        err "Could not install whiptail. Connect to the internet first (for Wi-Fi run: iwctl station wlan0 connect YOUR-NETWORK), then run the installer again."
    fi
fi

required_cmds=(lsblk sgdisk partprobe udevadm wipefs mkfs.fat mkfs.ext4 pacstrap arch-chroot genfstab findmnt)
[[ "$UNATTENDED" == yes ]] || required_cmds+=(whiptail)
for cmd in "${required_cmds[@]}"; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        err "Required command '$cmd' is missing."
    fi
done

umount -R /mnt 2>/dev/null || true

if [[ -d /sys/firmware/efi ]]; then
    BOOT_MODE="uefi"
else
    BOOT_MODE="bios"
fi

# How to install:
#   copy      copy the Sona live system on this ISO to the disk. Fast, and
#             works with no internet. Used when running from the Sona ISO.
#   download  download every package (pacstrap). Used from a stock Arch ISO.
LIVE_IMAGE=/run/archiso/bootmnt/arch/x86_64/airootfs.sfs
if [[ -f "$LIVE_IMAGE" && -f /usr/share/sona/live-files.txt && -d /usr/share/sona/boot ]]; then
    INSTALL_METHOD=copy
else
    INSTALL_METHOD=download
fi
if [[ "$UNATTENDED" == yes && -n "$(ans INSTALL_METHOD)" && "$(ans INSTALL_METHOD)" != auto ]]; then
    INSTALL_METHOD=$(ans INSTALL_METHOD)
    [[ "$INSTALL_METHOD" == download || ( "$INSTALL_METHOD" == copy && -f "$LIVE_IMAGE" ) ]] ||
        err "Answer file: INSTALL_METHOD must be auto, download, or copy (copy only works from the Sona ISO)."
fi
ONLINE=y

ui_msg "Welcome" "Welcome to the Sona Linux installer.

This computer started in ${BOOT_MODE^^} mode, so Sona will be set up to boot the same way.

Press Enter to continue. You can press Escape on any question to quit before any disk is changed."

# ---------------------------------------------------------------------------
# 2. Network and Wi-Fi setup
# ---------------------------------------------------------------------------

# Some networks (and QEMU's built-in network) block ping, so fall back to
# fetching a web page.
have_internet() {
    ping -c 1 -W 3 archlinux.org >/dev/null 2>&1 \
        || ping -c 1 -W 3 1.1.1.1 >/dev/null 2>&1 \
        || curl -fsS --max-time 8 -o /dev/null https://archlinux.org 2>/dev/null
}

first_wifi_iface() {
    local dev
    for dev in /sys/class/net/*; do
        if [[ -d "$dev/wireless" ]]; then
            basename "$dev"
            return 0
        fi
    done
    return 1
}

# Use whichever Wi-Fi service is running: NetworkManager on the live
# desktop, iwd on the live console or a stock Arch ISO.
pick_wifi_tool() {
    if systemctl is-active -q NetworkManager 2>/dev/null && command -v nmcli >/dev/null 2>&1; then
        WIFI_TOOL="nmcli"
    elif command -v iwctl >/dev/null 2>&1; then
        WIFI_TOOL="iwctl"
        systemctl start iwd 2>/dev/null || true
    elif command -v nmcli >/dev/null 2>&1; then
        WIFI_TOOL="nmcli"
    else
        err "Neither iwctl nor nmcli is available for Wi-Fi."
    fi
}

# Connect to $1 with password $2 (blank for an open network).
wifi_connect() {
    local iface="$1" ssid="$2" pass="$3"
    echo "Connecting to $ssid..."
    if [[ "$WIFI_TOOL" == "iwctl" ]]; then
        iwctl station "$iface" scan >/dev/null 2>&1 || true
        sleep 3
        if [[ -n "$pass" ]]; then
            iwctl --passphrase "$pass" station "$iface" connect "$ssid" || true
        else
            iwctl station "$iface" connect "$ssid" || true
        fi
    else
        if [[ -n "$pass" ]]; then
            nmcli dev wifi connect "$ssid" password "$pass" || true
        else
            nmcli dev wifi connect "$ssid" || true
        fi
    fi
    sleep 4
}

setup_network_unattended() {
    local iface
    if have_internet; then
        return 0
    fi
    SELECTED_SSID=$(ans WIFI_SSID)
    WIFI_PASS=$(ans WIFI_PASS)
    if [[ -n "$SELECTED_SSID" ]]; then
        iface=$(first_wifi_iface) || err "Answer file sets WIFI_SSID, but no wireless network card was found."
        rfkill unblock wifi 2>/dev/null || true
        ip link set "$iface" up 2>/dev/null || true
        pick_wifi_tool
        wifi_connect "$iface" "$SELECTED_SSID" "$WIFI_PASS"
    fi
    echo "Waiting for the internet connection..."
    for _ in $(seq 1 30); do
        have_internet && return 0
        sleep 2
    done
    err "No internet connection. Plug in a network cable, or set WIFI_SSID and WIFI_PASS in the answer file."
}

setup_network() {
    local net_type wifi_iface selected_idx menu_items i

    if have_internet; then
        return 0
    fi

    net_type=$(ui_menu "Network Connection" "How are you connecting to the internet?" \
        "1" "Wi-Fi (scan and select a wireless network)" \
        "2" "Ethernet (plugged in with a cable)")

    if [[ "$net_type" == "1" ]]; then
        wifi_iface=$(first_wifi_iface) || err "No wireless network card detected."

        rfkill unblock wifi 2>/dev/null || true
        ip link set "$wifi_iface" up 2>/dev/null || true

        pick_wifi_tool

        while true; do
            echo "Scanning for Wi-Fi networks on $wifi_iface..."
            SSIDS=()
            if [[ "$WIFI_TOOL" == "iwctl" ]]; then
                iwctl station "$wifi_iface" scan >/dev/null 2>&1 || true
                sleep 3
                mapfile -t SSIDS < <(
                    iwctl station "$wifi_iface" get-networks |
                    sed 's/\x1b\[[0-9;]*[a-zA-Z]//g' |
                    awk 'NR>4 {
                        sub(/^[[:space:]>*]+/, "");
                        sub(/[[:space:]]+(psk|open|8021x).*$/, "");
                        if (length($0) > 0) print $0
                    }' | awk '!seen[$0]++'
                )
            else
                mapfile -t SSIDS < <(nmcli -t -f SSID dev wifi list --rescan yes | grep -v '^$' | awk '!seen[$0]++')
            fi

            if [[ ${#SSIDS[@]} -eq 0 ]]; then
                if [[ $(ui_yesno "No Networks Found" "No Wi-Fi networks were found. Scan again?") == "y" ]]; then
                    continue
                fi
                err "Could not find any Wi-Fi networks."
            fi

            menu_items=()
            for i in "${!SSIDS[@]}"; do
                menu_items+=("$((i + 1))" "${SSIDS[$i]}")
            done

            selected_idx=$(ui_menu "Select Wi-Fi Network" "Use Up and Down arrows or press a number to choose your Wi-Fi:" "${menu_items[@]}")

            SELECTED_SSID="${SSIDS[$((selected_idx - 1))]}"
            WIFI_PASS=$(ui_pass "Wi-Fi Password" "Enter the password for $SELECTED_SSID (leave blank if it is open):")

            wifi_connect "$wifi_iface" "$SELECTED_SSID" "$WIFI_PASS"
            if have_internet; then
                break
            fi

            if [[ $(ui_yesno "Connection Failed" "Could not connect to $SELECTED_SSID. Try again?") != "y" ]]; then
                err "Network setup aborted."
            fi
        done
    else
        echo "Waiting for the wired connection..."
        sleep 5
    fi

    if ! have_internet; then
        err "No internet connection detected."
    fi
}

if [[ "$INSTALL_METHOD" == copy ]] && ! have_internet; then
    # Copying the live system needs no internet. Without it, updates, AUR
    # apps, and the OpenEVV voice come later, once the computer is online.
    if [[ "$UNATTENDED" == yes ]]; then
        if [[ -n "$(ans WIFI_SSID)" ]]; then
            setup_network_unattended
        else
            ONLINE=n
        fi
    elif [[ $(ui_yesno "No Internet" "This computer is not connected to the internet.

Sona can be installed without internet. Updates, extra apps like Google Chrome, and the OpenEVV voice will be added later, once the computer is online.

Connect to the internet now? Choose No to install without it.") == "y" ]]; then
        setup_network
    else
        ONLINE=n
    fi
elif [[ "$UNATTENDED" == yes ]]; then
    setup_network_unattended
else
    setup_network
fi
echo "Installing with method: $INSTALL_METHOD, internet: $ONLINE" >> "$LOG"

if [[ "$ONLINE" == y ]]; then
    step "Getting ready" "Setting up package signing keys and finding fast download mirrors."
    sed -i 's/^#\?ParallelDownloads.*/ParallelDownloads = 5/' /etc/pacman.conf
    quietly pacman-key --init
    quietly pacman-key --populate archlinux
    quietly pacman -Sy --noconfirm --needed archlinux-keyring reflector
    if ! quietly reflector --latest 20 --protocol https --sort rate --save /etc/pacman.d/mirrorlist; then
        echo "Warning: mirror ranking failed. Using the existing mirror list." >> "$LOG"
    fi
else
    step "Getting ready" "No internet: installing from this disc only."
fi

# ---------------------------------------------------------------------------
# 3. User and system settings
# ---------------------------------------------------------------------------

valid_username() { [[ "$1" =~ ^[a-z_][a-z0-9_-]{0,31}$ && "$1" != "root" ]]; }
valid_hostname() { [[ "$1" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]]; }
valid_timezone() { [[ -n "$1" && -f "/usr/share/zoneinfo/$1" ]]; }
valid_locale()   { grep -q "^${1//./\\.} UTF-8" /usr/share/i18n/SUPPORTED 2>/dev/null; }
yes_or_no()      { case "${1,,}" in y|yes|true|1) echo "y" ;; *) echo "n" ;; esac; }

if [[ "$UNATTENDED" == yes ]]; then
    FULLNAME=$(ans FULLNAME "Sona User")
    USERNAME=$(ans USERNAME "sona"); USERNAME="${USERNAME,,}"
    valid_username "$USERNAME" || err "Answer file: USERNAME \"$USERNAME\" is not a valid username."
    HOSTNAME=$(ans HOSTNAME "sona-pc"); HOSTNAME="${HOSTNAME,,}"
    valid_hostname "$HOSTNAME" || err "Answer file: HOSTNAME \"$HOSTNAME\" is not a valid computer name."
    PASSWORD=$(ans PASSWORD)
    [[ -n "$PASSWORD" ]] || err "Answer file: PASSWORD is required."
    ROOT_PASSWORD=$(ans ROOT_PASSWORD "$PASSWORD")
    AUTOLOGIN=$(yes_or_no "$(ans AUTOLOGIN no)")
    XP_THEME=$(yes_or_no "$(ans XP_THEME no)")
    TIMEZONE=$(ans TIMEZONE "UTC")
    valid_timezone "$TIMEZONE" || err "Answer file: TIMEZONE \"$TIMEZONE\" is not a known time zone."
    LANG_LOCALE=$(ans LANG_LOCALE "en_US.UTF-8")
    valid_locale "$LANG_LOCALE" || err "Answer file: LANG_LOCALE \"$LANG_LOCALE\" is not a supported UTF-8 locale."
    CONSOLE_KEYMAP=$(ans CONSOLE_KEYMAP "us")
    X11_KEYBOARD=$(ans X11_KEYBOARD "us")
else
    FULLNAME=$(ui_input "User Setup" "Enter your full name:" "Sona User")

    while true; do
        USERNAME=$(ui_input "User Setup" "Enter a lowercase username (no spaces):" "sona")
        USERNAME="${USERNAME,,}"
        valid_username "$USERNAME" && break
        ui_msg "Invalid Username" "The username must start with a letter, be 32 characters or fewer, and use only lowercase letters, numbers, underscores, or hyphens."
    done

    while true; do
        HOSTNAME=$(ui_input "Computer Name" "Enter a name for this computer (hostname):" "sona-pc")
        HOSTNAME="${HOSTNAME,,}"
        valid_hostname "$HOSTNAME" && break
        ui_msg "Invalid Computer Name" "The computer name can use only letters, numbers, and hyphens, and cannot start or end with a hyphen."
    done

    while true; do
        PASSWORD=$(ui_pass "Password Setup" "Enter a password for $USERNAME:")
        PASS_CONFIRM=$(ui_pass "Password Setup" "Confirm your password:")
        if [[ -n "$PASSWORD" && "$PASSWORD" == "$PASS_CONFIRM" ]]; then
            break
        fi
        ui_msg "Password Mismatch" "The passwords did not match or were blank. Please try again."
    done

    if [[ $(ui_yesno "Administrator Password" "Use the same password for the root (administrator) account?

Choose No to set a separate root password.") == "y" ]]; then
        ROOT_PASSWORD="$PASSWORD"
    else
        while true; do
            ROOT_PASSWORD=$(ui_pass "Root Password" "Enter a password for the root account:")
            ROOT_CONFIRM=$(ui_pass "Root Password" "Confirm the root password:")
            if [[ -n "$ROOT_PASSWORD" && "$ROOT_PASSWORD" == "$ROOT_CONFIRM" ]]; then
                break
            fi
            ui_msg "Password Mismatch" "The passwords did not match or were blank. Please try again."
        done
    fi

    AUTOLOGIN=$(ui_yesno "Automatic Login" "Log into the SonicDE desktop automatically on startup without asking for your password?

If you choose No, you log in at the talking text console, and the desktop starts with Orca as soon as you have logged in.")

    # Optional: No is selected, so pressing Enter keeps the SonicDE sounds.
    XP_THEME=$(ui_yesno_default_no "Windows XP Sounds" "Make the desktop sound like Windows XP?

This adds the Windows XP startup, logon, logoff, shutdown, window, notification, and USB device sounds, plus AutoPlay and Safely Remove Hardware. The sounds are downloaded from archive.org the first time you log in.

Choose No to keep the standard SonicDE sounds.")

    while true; do
        TZ_CHOICE=$(ui_menu "Time Zone" "Select your time zone:" \
            "1" "America/New_York (Eastern)" \
            "2" "America/Chicago (Central)" \
            "3" "America/Denver (Mountain)" \
            "4" "America/Phoenix (Arizona)" \
            "5" "America/Los_Angeles (Pacific)" \
            "6" "UTC" \
            "7" "Europe/London" \
            "8" "Type a time zone")

        case "$TZ_CHOICE" in
            1) TIMEZONE="America/New_York" ;;
            2) TIMEZONE="America/Chicago" ;;
            3) TIMEZONE="America/Denver" ;;
            4) TIMEZONE="America/Phoenix" ;;
            5) TIMEZONE="America/Los_Angeles" ;;
            6) TIMEZONE="UTC" ;;
            7) TIMEZONE="Europe/London" ;;
            8) TIMEZONE=$(ui_input "Time Zone" "Enter a full time zone name, for example America/Chicago:" "America/Chicago") ;;
        esac

        valid_timezone "$TIMEZONE" && break
        ui_msg "Unknown Time Zone" "\"$TIMEZONE\" is not a known time zone. Please try again."
    done

    while true; do
        LANG_LOCALE=$(ui_input "Language Locale" "Confirm the system locale:" "en_US.UTF-8")
        valid_locale "$LANG_LOCALE" && break
        ui_msg "Unknown Locale" "\"$LANG_LOCALE\" is not a supported UTF-8 locale. Use a name like en_US.UTF-8 or en_GB.UTF-8."
    done

    CONSOLE_KEYMAP=$(ui_input "Console Keymap" "Confirm the console keyboard layout:" "us")
    X11_KEYBOARD=$(ui_input "Desktop Keyboard" "Confirm the desktop keyboard layout:" "us")
fi

# ---------------------------------------------------------------------------
# 4. Disk selection and partitioning
# ---------------------------------------------------------------------------

# Never offer the USB stick the installer is running from.
LIVE_DISK=""
if live_src=$(findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null); then
    live_parent=$(lsblk -no PKNAME "$live_src" 2>/dev/null | head -n 1 || true)
    if [[ -n "$live_parent" ]]; then
        LIVE_DISK="/dev/$live_parent"
    else
        LIVE_DISK="$live_src"
    fi
fi

DISK_NAMES=()
DISK_DESC=()
disk_menu=()
while read -r d_name d_type d_ro d_size d_model; do
    [[ "$d_type" == "disk" ]] || continue
    [[ "$d_ro" == "0" ]] || continue
    [[ "$d_name" == "$LIVE_DISK" ]] && continue
    [[ "$d_name" == /dev/zram* ]] && continue
    DISK_NAMES+=("$d_name")
    DISK_DESC+=("$d_name, $d_size, ${d_model:-unknown model}")
    disk_menu+=("${#DISK_NAMES[@]}" "$d_name  $d_size  ${d_model:-unknown model}")
done < <(lsblk -dnpo NAME,TYPE,RO,SIZE,MODEL)

if [[ ${#DISK_NAMES[@]} -eq 0 ]]; then
    err "No storage drives were found to install to."
fi

if [[ "$UNATTENDED" == yes ]]; then
    want_disk=$(ans DISK)
    [[ -n "$want_disk" ]] || err "Answer file: DISK is required (a path like /dev/sda, or auto)."
    if [[ "$want_disk" == "auto" ]]; then
        # "auto" is only allowed when there is exactly one possible drive,
        # so an answer file can never pick the wrong one.
        [[ ${#DISK_NAMES[@]} -eq 1 ]] || err "Answer file: DISK=auto needs exactly one drive, but ${#DISK_NAMES[@]} were found. Set DISK to a path."
        disk_idx=1
    else
        disk_idx=""
        for i in "${!DISK_NAMES[@]}"; do
            [[ "${DISK_NAMES[$i]}" == "$want_disk" ]] && disk_idx=$((i + 1))
        done
        [[ -n "$disk_idx" ]] || err "Answer file: DISK $want_disk is not an available drive. Available: ${DISK_NAMES[*]}"
    fi
else
    disk_idx=$(ui_menu "Select Installation Drive" "Choose the drive to install Sona Linux onto:" "${disk_menu[@]}")
fi
DISK="${DISK_NAMES[$((disk_idx - 1))]}"
DISK_LABEL="${DISK_DESC[$((disk_idx - 1))]}"

if [[ "$UNATTENDED" == yes ]]; then
    case "$(ans PART_MODE erase)" in
        erase) PART_MODE=1 ;;
        existing) PART_MODE=2 ;;
        *) err "Answer file: PART_MODE must be erase or existing." ;;
    esac
    [[ "$(ans CONFIRM_ERASE)" == "yes" ]] || err "Answer file: set CONFIRM_ERASE=yes to confirm that data will be erased on $DISK_LABEL."
    echo "Installing to $DISK_LABEL (PART_MODE=$(ans PART_MODE erase))"
else
    PART_MODE=$(ui_menu "Partitioning Method" "How would you like to install onto $DISK_LABEL?" \
        "1" "Erase the entire drive and set up Sona Linux automatically" \
        "2" "Dual-boot: use a partition I already created for Sona")
fi

EFI_PART=""
GRUB_REMOVABLE="no"
ESP_TYPE="c12a7328-f81f-11d2-ba4b-00a0c93ec93b"
BIOS_BOOT_TYPE="21686148-6449-6e6f-744e-656564454649"

if [[ "$PART_MODE" == "2" ]]; then
    # --- EFI system partition (UEFI only) ---
    if [[ "$BOOT_MODE" == "uefi" ]]; then
        ESP_LIST=()
        esp_menu=()
        while IFS= read -r line; do
            p_name=$(lsblk_field NAME "$line")
            p_ptype=$(lsblk_field PARTTYPE "$line")
            p_size=$(lsblk_field SIZE "$line")
            p_parent=$(lsblk_field PKNAME "$line")
            # Skip the EFI partition on the installer USB itself.
            if [[ -n "$LIVE_DISK" && "${p_parent#/dev/}" == "${LIVE_DISK#/dev/}" ]]; then
                continue
            fi
            if [[ "${p_ptype,,}" == "$ESP_TYPE" ]]; then
                ESP_LIST+=("$p_name")
                esp_menu+=("${#ESP_LIST[@]}" "$p_name  $p_size")
            fi
        done < <(lsblk -npP -o NAME,PARTTYPE,SIZE,PKNAME)

        if [[ ${#ESP_LIST[@]} -eq 0 ]]; then
            err "No EFI system partition was found. Dual-boot on a UEFI computer needs the one Windows or your other system already uses."
        elif [[ "$UNATTENDED" == yes && -n "$(ans EFI_PART)" ]]; then
            EFI_PART=$(ans EFI_PART)
            [[ " ${ESP_LIST[*]} " == *" $EFI_PART "* ]] || err "Answer file: EFI_PART $EFI_PART is not an EFI system partition. Found: ${ESP_LIST[*]}"
        elif [[ ${#ESP_LIST[@]} -eq 1 ]]; then
            EFI_PART="${ESP_LIST[0]}"
            ui_msg "EFI Partition" "Sona will add its boot loader to the existing EFI partition $EFI_PART. It will not be formatted, and your other system's boot files will be kept."
        elif [[ "$UNATTENDED" == yes ]]; then
            err "Answer file: several EFI partitions were found (${ESP_LIST[*]}). Set EFI_PART to one of them."
        else
            esp_idx=$(ui_menu "EFI Partition" "Choose the existing EFI partition to add the Sona boot loader to. It will not be formatted:" "${esp_menu[@]}")
            EFI_PART="${ESP_LIST[$((esp_idx - 1))]}"
        fi
    else
        # Legacy BIOS on a GPT drive needs a BIOS boot partition for GRUB.
        pttype=$(blkid -o value -s PTTYPE "$DISK" 2>/dev/null || true)
        if [[ "$pttype" == "gpt" ]] && ! lsblk -lnpo PARTTYPE "$DISK" | grep -qi "$BIOS_BOOT_TYPE"; then
            err "$DISK uses a GPT partition table but has no 1 MiB BIOS boot partition, so GRUB cannot be installed on this BIOS computer. Create one with gdisk (type code EF02) and run the installer again."
        fi
    fi

    # --- Root partition ---
    ROOT_LIST=()
    ROOT_FS=()
    root_menu=()
    # lsblk -P prints KEY="value" pairs, so empty columns cannot shift.
    while IFS= read -r line; do
        p_name=$(lsblk_field NAME "$line")
        p_type=$(lsblk_field TYPE "$line")
        p_size=$(lsblk_field SIZE "$line")
        p_fstype=$(lsblk_field FSTYPE "$line")
        p_ptype=$(lsblk_field PARTTYPE "$line")
        p_label=$(lsblk_field LABEL "$line")
        [[ "$p_type" == "part" ]] || continue
        [[ "${p_ptype,,}" == "$ESP_TYPE" || "${p_ptype,,}" == "$BIOS_BOOT_TYPE" ]] && continue
        [[ "$p_name" == "$EFI_PART" ]] && continue
        ROOT_LIST+=("$p_name")
        ROOT_FS+=("$p_fstype")
        root_menu+=("${#ROOT_LIST[@]}" "$p_name  $p_size  ${p_fstype:-unformatted}  ${p_label}")
    done < <(lsblk -npP -o NAME,TYPE,SIZE,FSTYPE,PARTTYPE,LABEL "$DISK")

    if [[ ${#ROOT_LIST[@]} -eq 0 ]]; then
        err "No usable partitions were found on $DISK. Shrink your other system first to make free space, create a partition for Sona, and run the installer again."
    fi

    if [[ "$UNATTENDED" == yes ]]; then
        want_root=$(ans ROOT_PART)
        [[ -n "$want_root" ]] || err "Answer file: PART_MODE=existing needs ROOT_PART."
        root_idx=""
        for i in "${!ROOT_LIST[@]}"; do
            [[ "${ROOT_LIST[$i]}" == "$want_root" ]] && root_idx=$((i + 1))
        done
        [[ -n "$root_idx" ]] || err "Answer file: ROOT_PART $want_root is not a usable partition on $DISK. Usable: ${ROOT_LIST[*]}"
    else
        root_idx=$(ui_menu "Sona Partition" "Choose the partition to install Sona Linux onto. It will be erased and formatted:" "${root_menu[@]}")
    fi
    ROOT_PART="${ROOT_LIST[$((root_idx - 1))]}"
    root_fs="${ROOT_FS[$((root_idx - 1))]}"

    case "$root_fs" in
        ""|ext4|ext3|ext2|btrfs|xfs)
            ;;
        *)
            if [[ $(ui_yesno_default_no "Existing Data Found" "$ROOT_PART contains a $root_fs file system. It may hold Windows or your personal files.

Erasing it will destroy everything on it. Are you sure this is the right partition?") != "y" ]]; then
                err "Installation cancelled by user."
            fi
            ;;
    esac

    if [[ $(ui_yesno_default_no "Confirm Format" "Format $ROOT_PART as ext4 and install Sona Linux on it?

Everything on $ROOT_PART will be permanently erased. Other partitions will not be touched.") != "y" ]]; then
        err "Installation cancelled by user."
    fi

    umount "$ROOT_PART" 2>/dev/null || true
    swapoff "$ROOT_PART" 2>/dev/null || true
    step "Preparing the disk" "Formatting $ROOT_PART."
    quietly wipefs -af "$ROOT_PART"
    quietly mkfs.ext4 -F -L SonaRoot "$ROOT_PART"
else
    if [[ $(ui_yesno_default_no "Confirm Drive Erase" "WARNING: Everything on this drive will be permanently erased:

$DISK_LABEL

Continue?") != "y" ]]; then
        err "Installation cancelled by user."
    fi

    step "Preparing the disk" "Erasing and partitioning $DISK_LABEL."
    while read -r p; do
        umount "$p" 2>/dev/null || true
        swapoff "$p" 2>/dev/null || true
    done < <(lsblk -lnpo NAME "$DISK" | tail -n +2)

    quietly wipefs -af "$DISK"
    quietly sgdisk --zap-all "$DISK"
    # 1: 1 MiB BIOS boot (lets GRUB boot on legacy BIOS)
    # 2: 1 GiB EFI system partition
    # 3: Linux root, rest of the drive
    quietly sgdisk \
        -n 1:2048:+1M  -t 1:EF02 -c 1:BIOSBOOT \
        -n 2:0:+1G     -t 2:EF00 -c 2:EFI \
        -n 3:0:0       -t 3:8304 -c 3:SonaRoot \
        "$DISK"
    quietly partprobe "$DISK"
    quietly udevadm settle

    EFI_PART=$(part_path "$DISK" 2)
    ROOT_PART=$(part_path "$DISK" 3)
    wait_for_device "$EFI_PART"
    wait_for_device "$ROOT_PART"

    quietly mkfs.fat -F 32 -n EFI "$EFI_PART"
    quietly mkfs.ext4 -F -L SonaRoot "$ROOT_PART"

    # On a wiped drive it is safe to also install GRUB to the fallback EFI
    # path, so firmware that forgets boot entries can still start Sona.
    GRUB_REMOVABLE="yes"
fi

mount "$ROOT_PART" /mnt
MOUNTED=true
if [[ -n "$EFI_PART" ]]; then
    mkdir -p /mnt/boot/efi
    mount "$EFI_PART" /mnt/boot/efi
    esp_free=$(df --output=avail -m /mnt/boot/efi | tail -n 1 | tr -d ' ')
    if [[ "$esp_free" -lt 20 ]]; then
        err "The EFI partition $EFI_PART has only ${esp_free} MB free. Sona needs at least 20 MB there for its boot loader."
    fi
fi

# ---------------------------------------------------------------------------
# 5. Detect CPU microcode before pacstrap
# ---------------------------------------------------------------------------

UCODE_PKG=()
cpu_vendor=$(awk '/vendor_id/ {print $3; exit}' /proc/cpuinfo)
if [[ "$cpu_vendor" == "GenuineIntel" ]]; then
    UCODE_PKG=(intel-ucode)
elif [[ "$cpu_vendor" == "AuthenticAMD" ]]; then
    UCODE_PKG=(amd-ucode)
fi

# ---------------------------------------------------------------------------
# 6. Core base system
# ---------------------------------------------------------------------------

if [[ "$INSTALL_METHOD" == copy ]]; then
    step "Copying Sona to the disk" "This takes a few minutes."
    quietly unsquashfs -f -no-progress -d /mnt "$LIVE_IMAGE"
    # The ISO keeps the kernel outside the image; the copies of the kernel
    # and CPU microcode the image saved are put back in /boot (see
    # sona-live/airootfs/etc/pacman.d/hooks/sona-keep-boot.hook).
    mkdir -p /mnt/boot
    cp /mnt/usr/share/sona/boot/* /mnt/boot/
    rm -rf /mnt/usr/share/sona/boot
    # Replace the live system's resolver link with an empty file:
    # arch-chroot needs a file there to give the new system working DNS,
    # and NetworkManager writes the real one at first boot.
    rm -f /mnt/etc/resolv.conf
    touch /mnt/etc/resolv.conf
    [[ "$ONLINE" == y ]] && cp /etc/pacman.d/mirrorlist /mnt/etc/pacman.d/mirrorlist
else
    step "Installing the base system" "Downloading and installing the core packages. This takes a while."
    quietly pacstrap -K /mnt "${SONA_BASE_PKGS[@]}" "${UCODE_PKG[@]}"
fi

# Save the Wi-Fi network as a NetworkManager profile so it connects after reboot.
if [[ -n "$SELECTED_SSID" ]]; then
    NM_DIR=/mnt/etc/NetworkManager/system-connections
    NM_FILE="$NM_DIR/sona-wifi.nmconnection"
    mkdir -p "$NM_DIR"
    {
        echo "[connection]"
        echo "id=$SELECTED_SSID"
        echo "uuid=$(cat /proc/sys/kernel/random/uuid)"
        echo "type=wifi"
        echo "autoconnect=true"
        echo
        echo "[wifi]"
        echo "mode=infrastructure"
        echo "ssid=$SELECTED_SSID"
        echo
        if [[ -n "$WIFI_PASS" ]]; then
            echo "[wifi-security]"
            echo "key-mgmt=wpa-psk"
            echo "psk=$WIFI_PASS"
            echo
        fi
        echo "[ipv4]"
        echo "method=auto"
        echo
        echo "[ipv6]"
        echo "method=auto"
    } > "$NM_FILE"
    chmod 600 "$NM_FILE"
fi

genfstab -U /mnt > /mnt/etc/fstab

# ---------------------------------------------------------------------------
# 7. Pass configuration into the chroot
# ---------------------------------------------------------------------------

(
    umask 077
    cat > /mnt/root/install.conf <<EOF
FULLNAME=$(printf '%q' "$FULLNAME")
USERNAME=$(printf '%q' "$USERNAME")
PASSWORD=$(printf '%q' "$PASSWORD")
ROOT_PASSWORD=$(printf '%q' "$ROOT_PASSWORD")
HOSTNAME=$(printf '%q' "$HOSTNAME")
TIMEZONE=$(printf '%q' "$TIMEZONE")
LANG_LOCALE=$(printf '%q' "$LANG_LOCALE")
CONSOLE_KEYMAP=$(printf '%q' "$CONSOLE_KEYMAP")
X11_KEYBOARD=$(printf '%q' "$X11_KEYBOARD")
DISK=$(printf '%q' "$DISK")
AUTOLOGIN=$(printf '%q' "$AUTOLOGIN")
XP_THEME=$(printf '%q' "$XP_THEME")
BOOT_MODE=$(printf '%q' "$BOOT_MODE")
GRUB_REMOVABLE=$(printf '%q' "$GRUB_REMOVABLE")
INSTALL_AUR=$(printf '%q' "$(yes_or_no "$(ans INSTALL_AUR yes)")")
SERIAL_CONSOLE=$(printf '%q' "$(yes_or_no "$(ans SERIAL_CONSOLE no)")")
INSTALL_METHOD=$(printf '%q' "$INSTALL_METHOD")
ONLINE=$(printf '%q' "$ONLINE")
SONA_X_PKGS=($(printf '%q ' "${SONA_X_PKGS[@]}"))
SONA_DESKTOP_PKGS=($(printf '%q ' "${SONA_DESKTOP_PKGS[@]}"))
SONA_APP_PKGS=($(printf '%q ' "${SONA_APP_PKGS[@]}"))
SONA_XP_PKGS=($(printf '%q ' "${SONA_XP_PKGS[@]}"))
SONA_KOKORO_PKGS=($(printf '%q ' "${SONA_KOKORO_PKGS[@]}"))
SONA_STORMUX_PKGS=($(printf '%q ' "${SONA_STORMUX_PKGS[@]}"))
SONA_NVIDIA_PKGS=($(printf '%q ' "${SONA_NVIDIA_PKGS[@]}"))
EOF
)

cat << 'EOF' > /mnt/root/setup-chroot.sh
#!/bin/bash
set -Eeuo pipefail

on_chroot_error() {
    local rc=$?
    rm -f /etc/sudoers.d/99-sona-temp-nopasswd
    echo >&2
    echo "Error: system setup stopped at line $1 of setup-chroot.sh (exit code $rc)." >&2
    exit "$rc"
}
trap 'on_chroot_error $LINENO' ERR

# Progress for the installer's status box (see "@@STEP" in Install).
progress() { echo "@@STEP $*"; }

source /root/install.conf
# QUICK_TEST=y is set only by scripts/quick-test.sh, which runs this script
# in a container with no real disk: the clock and boot loader steps are
# skipped, everything else runs as in a real install.
QUICK_TEST="${QUICK_TEST:-n}"

INSTALL_METHOD="${INSTALL_METHOD:-download}"
ONLINE="${ONLINE:-y}"

# Install what is not installed yet. (After copying the live system nearly
# everything already is.) The package databases are synced once in step 6;
# syncing again before every install risks a partial upgrade. Returns 1 if
# something is missing and there is no internet to get it.
pac_install() {
    local missing
    missing=$(pacman -T "$@" || true)
    [[ -z "$missing" ]] && return 0
    if [[ "$ONLINE" != y ]]; then
        echo "Warning: no internet, so these were not installed:" $missing
        return 1
    fi
    # shellcheck disable=SC2086
    pacman -S --noconfirm --needed $missing
}

install_optional() {
    for pkg in "$@"; do
        pac_install "$pkg" || echo "Warning: Optional package $pkg skipped."
    done
}

# Signing keys for the SonicDE and XLibre repositories: the copies on the
# Sona ISO when there are any (so this works offline), otherwise downloaded.
# A key is trusted only if it has exactly the expected fingerprint.
add_repo_key() {
    local file="$1" url="$2" fpr="$3" tmp=/tmp/sona-repo-key.asc
    if [[ -f "/usr/share/sona/keys/$file" ]]; then
        cp "/usr/share/sona/keys/$file" "$tmp" || return 1
    else
        curl -fsSL --retry 3 -o "$tmp" "$url" || return 1
    fi
    pacman-key --add "$tmp" || { rm -f "$tmp"; return 1; }
    rm -f "$tmp"
    pacman-key --finger "$fpr" || return 1
    pacman-key --lsign-key "$fpr" || return 1
}

# 0. After copying the live system: turn it into a normal installed system.
if [[ "$INSTALL_METHOD" == copy ]]; then
    progress "Removing the live system's own settings."
    echo "Removing the live system's own settings..."
    # Every file the live ISO added on top of its packages (written by
    # scripts/build-iso.sh). The installer writes the real versions below.
    while IFS= read -r f; do
        [[ -n "$f" ]] && rm -f -- "/$f"
    done < /usr/share/sona/live-files.txt
    rm -f /usr/share/sona/live-files.txt
    : > /etc/environment
    # The live user and its groups.
    userdel -r sona 2>/dev/null || true
    groupdel autologin 2>/dev/null || true
    usermod -s /bin/bash root
    # Live-only packages. Installed systems have no graphical login manager.
    for pkg in mkinitcpio-archiso cloud-init lightdm-gtk-greeter lightdm; do
        pacman -Q "$pkg" >/dev/null 2>&1 && pacman -Rns --noconfirm "$pkg" || true
    done
    # This computer gets its own identity and keys, never the ISO's.
    rm -f /etc/machine-id /var/lib/dbus/machine-id /etc/ssh/ssh_host_*
    systemd-machine-id-setup
    rm -rf /etc/pacman.d/gnupg
    pacman-key --init
    pacman-key --populate archlinux
    # The copied pacman.conf already lists Sona's extra repositories, so
    # their keys must be trusted before the first sync (step 2). A
    # repository whose key cannot be added is turned off.
    add_repo_key xlibre-archlinux.asc https://xlibre-arch.github.io/xlibre-archlinux.asc \
        0C92313001CFCA27627B9098B97F7C613F359424 || sed -i '/^\[xlibre-stable\]/,/^$/ s/^/#/' /etc/pacman.conf
    add_repo_key sonicde-archlinux.asc https://sonicde-arch.github.io/sonicde-archlinux.asc \
        A85BB166B49A4C58C39125073B87898C73F11DF5 || sed -i '/^\[sonicde-stable\]/,/^$/ s/^/#/' /etc/pacman.conf
    add_repo_key stormux_repo.pub https://git.stormux.org/storm/stormux/raw/branch/master/x86_64/stormux_repo.pub \
        52ADA49000F1FF0456F8AEEFB4CDE1CD56EF8E82 || sed -i '/^\[stormux\]/,/^$/ s/^/#/' /etc/pacman.conf
    # A normal boot image, without the live ISO's hooks. The console
    # keyboard layout goes into it, so it is saved first.
    echo "KEYMAP=$CONSOLE_KEYMAP" > /etc/vconsole.conf
    mkinitcpio -P
fi

# 1. Timezone, clock, and locale
progress "Setting the time zone and language."
ln -sf "/usr/share/zoneinfo/$TIMEZONE" /etc/localtime
[[ "$QUICK_TEST" == "y" ]] || hwclock --systohc

echo "$LANG_LOCALE UTF-8" > /etc/locale.gen
locale-gen
echo "LANG=$LANG_LOCALE" > /etc/locale.conf

echo "$HOSTNAME" > /etc/hostname
echo "KEYMAP=$CONSOLE_KEYMAP" > /etc/vconsole.conf

# 2. Pacman tuning, multilib (required for Wine), and automatic maintenance timers
progress "Updating the system."
sed -i 's/^#Color/Color/' /etc/pacman.conf
sed -i 's/^#\?ParallelDownloads.*/ParallelDownloads = 5/' /etc/pacman.conf
sed -i '/^#\[multilib\]/,/^#Include = \/etc\/pacman.d\/mirrorlist/ s/^#//' /etc/pacman.conf
if [[ "$ONLINE" == y ]]; then
    if [[ "$INSTALL_METHOD" == copy ]]; then
        # The copied system is complete already; updating it is a bonus.
        pacman -Syu --noconfirm || echo "Warning: could not update the system now. Run: sudo pacman -Syu"
    else
        pacman -Syu --noconfirm
    fi
fi

systemctl enable archlinux-keyring-wkd-sync.timer
systemctl enable paccache.timer

# 3. Zram swap configuration
cat > /etc/systemd/zram-generator.conf << ZRAM
[zram0]
zram-size = ram / 2
compression-algorithm = zstd
ZRAM

# 4. Global accessibility and default browser environment variables
cat >> /etc/environment << A11Y_ENV
GTK_MODULES=gail:atk-bridge
QT_ACCESSIBILITY=1
QT_LINUX_ACCESSIBILITY_ALWAYS_ON=1
ACCESSIBILITY_ENABLED=1
GNOME_ACCESSIBILITY=1
A11Y_ENV

# 5. User accounts and sudoers
progress "Creating your user account."
echo "root:$ROOT_PASSWORD" | chpasswd
# The audio group lets this user's PipeWire reach the sound card at boot,
# before anyone logs in, so console speech works (see step 9).
useradd -m -c "$FULLNAME" -G wheel,input,lp,sys,audio -s /bin/bash "$USERNAME"
echo "$USERNAME:$PASSWORD" | chpasswd
USER_UID=$(id -u "$USERNAME")
echo "%wheel ALL=(ALL:ALL) ALL" > /etc/sudoers.d/10-wheel
chmod 0440 /etc/sudoers.d/10-wheel

# 6. XLibre repository and display server
progress "Adding package repositories and the X server."
add_repo_key xlibre-archlinux.asc https://xlibre-arch.github.io/xlibre-archlinux.asc \
    0C92313001CFCA27627B9098B97F7C613F359424 || { echo "Error: could not add the XLibre signing key." >&2; exit 1; }

if ! grep -q '^\[xlibre-stable\]' /etc/pacman.conf; then
    cat >> /etc/pacman.conf << 'REPO'

[xlibre-stable]
Server = https://packages.xlibre.net/arch/stable/$arch
REPO
fi

# 6b. SonicDE repository (the desktop). Packages are signed, and the key is
# trusted only if it matches this exact fingerprint from sonicde-arch.github.io.
SONICDE_KEY_FPR="A85BB166B49A4C58C39125073B87898C73F11DF5"
SONICDE_KEY_URL="https://sonicde-arch.github.io/sonicde-archlinux.asc"
add_repo_key sonicde-archlinux.asc "$SONICDE_KEY_URL" "$SONICDE_KEY_FPR" || { echo "Error: could not add the SonicDE signing key." >&2; exit 1; }
if ! grep -q '^\[sonicde-stable\]' /etc/pacman.conf; then
    cat >> /etc/pacman.conf << 'REPO'

[sonicde-stable]
Server = https://github.com/sonicde-arch/stable/releases/download/$arch
REPO
fi

# 6c. Community accessibility repositories: Stormux and Jenux.
# They are added after the official Arch repositories, so official packages
# always win when both have the same package name. These repos only add
# packages Arch does not have. A problem here never stops the install.

# Stormux (storm_dragon). Packages are signed. The key is trusted only if
# it matches this exact fingerprint.
STORMUX_KEY_FPR="52ADA49000F1FF0456F8AEEFB4CDE1CD56EF8E82"
STORMUX_KEY_URL="https://git.stormux.org/storm/stormux/raw/branch/master/x86_64/stormux_repo.pub"
# (After copying the live system, [stormux] is already in pacman.conf, but
# the keyring is new, so the key is always added.)
if add_repo_key stormux_repo.pub "$STORMUX_KEY_URL" "$STORMUX_KEY_FPR"; then
    if ! grep -q '^\[stormux\]' /etc/pacman.conf; then
        cat >> /etc/pacman.conf << 'REPO'

[stormux]
SigLevel = Required DatabaseOptional
Server = https://packages.stormux.org/$arch
REPO
    fi
else
    echo "Warning: could not add the Stormux signing key, so the Stormux repository was turned off."
    sed -i '/^\[stormux\]/,/^$/ s/^/#/' /etc/pacman.conf
fi

# Jenux (Nash). This repository is unsigned, as in Nash's own pacman.conf,
# so pacman cannot verify where its packages came from.
if ! grep -q '^\[jenux\]' /etc/pacman.conf; then
    cat >> /etc/pacman.conf << 'REPO'

[jenux]
SigLevel = Optional
Server = https://repo.jenux.dev
Server = https://nashcentral.duckdns.org/packages
REPO
fi

# If a community server is down, pacman refuses to sync at all. Turn the
# community repos off in that case instead of failing the whole install.
if [[ "$ONLINE" == y ]] && ! pacman -Syy; then
    echo "Warning: a community repository could not be reached, so Stormux and Jenux were turned off."
    echo "You can turn them back on later in /etc/pacman.conf."
    sed -i '/^\[stormux\]/,/^$/ s/^/#/; /^\[jenux\]/,/^$/ s/^/#/' /etc/pacman.conf
    # SonicDE is required for the desktop, so stop here if it is the one failing.
    pacman -Syy || { echo "Error: the SonicDE or Arch repositories could not be reached." >&2; exit 1; }
fi

# --ask 4 lets XLibre replace the standard X server without a question.
if [[ "$ONLINE" == y ]]; then
    pacman -Syyu --noconfirm --needed --ask 4 "${SONA_X_PKGS[@]}"
else
    pac_install "${SONA_X_PKGS[@]}"
fi

mkdir -p /etc/X11/xorg.conf.d
cat > /etc/X11/xorg.conf.d/00-keyboard.conf << XKB
Section "InputClass"
    Identifier "system-keyboard"
    MatchIsKeyboard "on"
    Option "XkbLayout" "$X11_KEYBOARD"
EndSection
XKB

# 7. Modern GPU, network, and virtualization driver detection
progress "Setting up drivers for this computer."
pac_install pciutils
gpu_info=$(lspci -nn | grep -Ei 'VGA|3D|Display' || true)
# nvidia-open only supports Turing (RTX 20 / GTX 16) and newer chips:
# TU1xx, GA1xx, AD1xx, GB2xx, GH1xx. Older cards keep the open-source
# nouveau driver, which mesa already provides.
if echo "$gpu_info" | grep -qi nvidia && ! echo "$gpu_info" | grep -Eqi '\b(TU|GA|AD|GB|GH)[0-9]{3}'; then
    echo "Note: this NVIDIA card is older than RTX 20 / GTX 16. Using the open-source nouveau driver."
fi
if echo "$gpu_info" | grep -qi nvidia && echo "$gpu_info" | grep -Eqi '\b(TU|GA|AD|GB|GH)[0-9]{3}'; then
    if ! pac_install nvidia-open nvidia-utils nvidia-settings; then
        echo "The NVIDIA driver will be needed later: sudo pacman -S nvidia-open nvidia-utils nvidia-settings"
    else
        mkdir -p /etc/mkinitcpio.conf.d
        cat > /etc/mkinitcpio.conf.d/nvidia.conf << NVMODS
MODULES+=(nvidia nvidia_modeset nvidia_uvm nvidia_drm)
NVMODS
        [[ "$QUICK_TEST" == "y" ]] || mkinitcpio -P
        if echo "$gpu_info" | grep -Eqi 'Intel|AMD|ATI'; then
            install_optional nvidia-prime
        else
            pacman -Q nvidia-prime >/dev/null 2>&1 && pacman -Rns --noconfirm nvidia-prime || true
        fi
    fi
elif [[ "$INSTALL_METHOD" == copy ]]; then
    # The live ISO carries the NVIDIA driver; this computer cannot use it,
    # and leaving it would keep the open-source nouveau driver turned off.
    for pkg in nvidia-prime nvidia-settings nvidia-open nvidia-utils; do
        pacman -Q "$pkg" >/dev/null 2>&1 && pacman -Rns --noconfirm "$pkg" || true
    done
fi

net_info=$(lspci | grep -i network || true)
if echo "$net_info" | grep -qi broadcom; then
    install_optional dkms broadcom-wl-dkms
fi

if grep -qi microsoft /sys/class/dmi/id/sys_vendor 2>/dev/null; then
    install_optional hyperv
    systemctl enable hv_fcopy_daemon.service hv_kvp_daemon.service hv_vss_daemon.service || true
fi

# 7b. GRUB boot loader
progress "Installing the boot loader."
# Installed before the desktop and AUR steps, so a later problem cannot
# leave the computer unable to boot.
if [[ "$SERIAL_CONSOLE" == "y" ]]; then
    # Also send boot messages and a login prompt to the first serial port.
    # Used by the automated install test; harmless on real hardware.
    sed -i 's/^GRUB_CMDLINE_LINUX_DEFAULT=.*/GRUB_CMDLINE_LINUX_DEFAULT="loglevel=4 console=tty0 console=ttyS0,115200"/' /etc/default/grub
fi
if grep -q '^#\?GRUB_DISABLE_OS_PROBER=' /etc/default/grub; then
    sed -i 's/^#\?GRUB_DISABLE_OS_PROBER=.*/GRUB_DISABLE_OS_PROBER=false/' /etc/default/grub
else
    echo "GRUB_DISABLE_OS_PROBER=false" >> /etc/default/grub
fi

if [[ "$QUICK_TEST" == "y" ]]; then
    echo "Quick test: skipping grub-install."
elif [[ "$BOOT_MODE" == "uefi" ]]; then
    grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=Sona --recheck
    if [[ "$GRUB_REMOVABLE" == "yes" ]]; then
        # Fallback copy at EFI/BOOT/BOOTX64.EFI for firmware that loses boot entries.
        grub-install --target=x86_64-efi --efi-directory=/boot/efi --removable --recheck
    fi
else
    grub-install --target=i386-pc --recheck "$DISK"
fi
[[ "$QUICK_TEST" == "y" ]] || grub-mkconfig -o /boot/grub/grub.cfg

# 8. SonicDE desktop and full application suite
progress "Installing the SonicDE desktop and apps. This is the longest part."
pac_install "${SONA_DESKTOP_PKGS[@]}"
install_optional "${SONA_APP_PKGS[@]}"
install_optional "${SONA_KOKORO_PKGS[@]}"
# wine-access comes from the Stormux repository (skipped if that is off).
install_optional "${SONA_STORMUX_PKGS[@]}"

# 9. Core services, Printing, Timeshift, Bluetooth, Flathub, and Speech
progress "Setting up speech, sound, printing, and Bluetooth."
# There is no graphical login manager: you log in at the talking text
# console (or automatically), and the desktop starts from there (step 11).
systemctl enable \
    NetworkManager \
    bluetooth \
    cups.service \
    avahi-daemon.service \
    cronie.service \
    espeakup \
    systemd-timesyncd
# speech-dispatcher is not enabled as a system service on purpose: Orca
# starts its own per-user copy. (The old "systemctl enable speech-dispatcher"
# line failed because the unit is really named speech-dispatcherd, which
# stopped the whole install before the boot loader was set up.)

echo "speakup_soft" > /etc/modules-load.d/speakup.conf

# Console speech with PipeWire:
# espeakup runs as root, but PipeWire runs per user. "Lingering" starts the
# user's PipeWire at boot, before login, and the drop-in below points root's
# espeakup at that user's PipeWire socket.
mkdir -p /var/lib/systemd/linger
touch "/var/lib/systemd/linger/$USERNAME"

mkdir -p /etc/systemd/system/espeakup.service.d
cat > /etc/systemd/system/espeakup.service.d/10-sona-pipewire.conf << ESPEAKUP_DROPIN
[Unit]
Wants=user@${USER_UID}.service
After=user@${USER_UID}.service

[Service]
Environment=PIPEWIRE_RUNTIME_DIR=/run/user/${USER_UID}
Environment=XDG_RUNTIME_DIR=/run/user/${USER_UID}
Restart=on-failure
RestartSec=3
ESPEAKUP_DROPIN

# Keep the sound card awake so the first words of speech are not cut off.
mkdir -p /etc/wireplumber/wireplumber.conf.d
cat > /etc/wireplumber/wireplumber.conf.d/50-sona-no-suspend.conf << WP_NOSUSPEND
monitor.alsa.rules = [
  {
    matches = [
      { node.name = "~alsa_output.*" }
      { node.name = "~alsa_input.*" }
    ]
    actions = {
      update-props = {
        session.suspend-timeout-seconds = 0
      }
    }
  }
]
WP_NOSUSPEND

if grep -q '^hosts:' /etc/nsswitch.conf && ! grep -q 'mdns_minimal' /etc/nsswitch.conf; then
    sed -i 's/^hosts: files mymachines/hosts: files mymachines mdns_minimal [NOTFOUND=return]/' /etc/nsswitch.conf
fi

if [[ -f /etc/bluetooth/main.conf ]]; then
    sed -i 's/^#*\s*AutoEnable.*/AutoEnable=true/' /etc/bluetooth/main.conf
fi

if [[ -f /etc/speech-dispatcher/speechd.conf ]]; then
    sed -i 's/^#*\s*AudioOutputMethod.*/AudioOutputMethod "pulse"/' /etc/speech-dispatcher/speechd.conf
fi

flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo || true

# 10. QuickMail-style 3-Pane Accessible Layout for Thunderbird
mkdir -p /usr/lib/thunderbird/defaults/pref
cat > /usr/lib/thunderbird/defaults/pref/sona-quickmail.js << TBPREF
// Sona Linux: QuickMail-inspired accessible 3-pane configuration
pref("mail.pane_config.dynamic", 0);
pref("mail.threadpane.listview", 1);
pref("mailnews.start_page.enabled", false);
pref("spacesToolbar.shown", false);
pref("mail.tabs.autoHide", true);
TBPREF

# 11. Login: talking console on tty1, then SonicDE with Orca.
progress "Setting up the login and Orca."
# Speakup (espeakup) talks at the console login. When you log in on tty1,
# ~/.bash_profile stops espeakup so it never talks over Orca, starts the
# desktop, and starts espeakup again when the desktop closes.
echo "%wheel ALL=(root) NOPASSWD: /usr/bin/systemctl stop espeakup.service, /usr/bin/systemctl start espeakup.service" > /etc/sudoers.d/20-sona-espeakup
chmod 0440 /etc/sudoers.d/20-sona-espeakup

if [[ "$AUTOLOGIN" == "y" ]]; then
    # -f in -o is required: without it login still asks for the password.
    mkdir -p /etc/systemd/system/getty@tty1.service.d
    {
        echo "[Service]"
        echo "ExecStart="
        printf '%s\n' "ExecStart=-/sbin/agetty -o '-p -f -- \\\\u' --noclear --autologin $USERNAME %I \$TERM"
    } > /etc/systemd/system/getty@tty1.service.d/10-sona-autologin.conf
fi

write_login_files() {
    local home="$1"
    cat > "$home/.bash_profile" << 'BASH_PROFILE'
#
# ~/.bash_profile
#

[[ -f ~/.bashrc ]] && . ~/.bashrc

# Sona Linux: start the SonicDE desktop after logging in on tty1.
# Speakup (espeakup) is stopped first so it never talks over Orca, and
# started again when the desktop closes, leaving a talking console.
if [ -z "$DISPLAY" ] && [ "$XDG_VTNR" = 1 ]; then
  sudo -n systemctl stop espeakup.service
  startx -- -keeptty >~/.xorg-startx.log 2>&1
  sudo -n systemctl start espeakup.service
fi
BASH_PROFILE

    cat > "$home/.xinitrc" << 'XINITRC'
#!/bin/sh
# Sona Linux: start SonicDE (run by startx from ~/.bash_profile).
if [ -d /etc/X11/xinit/xinitrc.d ]; then
  for f in /etc/X11/xinit/xinitrc.d/?*.sh; do
    [ -r "$f" ] && . "$f"
  done
  unset f
fi
[ -f "$HOME/.xprofile" ] && . "$HOME/.xprofile"
export XDG_CURRENT_DESKTOP=KDE XDG_SESSION_DESKTOP=KDE DESKTOP_SESSION=sonicde
exec /usr/bin/startplasma-x11
XINITRC
    chmod 755 "$home/.xinitrc"
}
write_login_files /etc/skel
write_login_files "/home/$USERNAME"

# 12. SonicDE accessibility and keyboard shortcuts
# Orca starts with every SonicDE session.
mkdir -p /etc/xdg/autostart
cat > /etc/xdg/autostart/sona-orca.desktop << ORCA_AUTOSTART
[Desktop Entry]
Type=Application
Name=Orca screen reader
Exec=orca --replace
OnlyShowIn=KDE;
X-KDE-autostart-phase=1
ORCA_AUTOSTART

# Never open the SonicDE Welcome Center by itself: it takes focus from the
# desktop at first login, so Orca has nothing useful to read.
cat > /etc/xdg/kded6rc << KDED_RC
[Module-plasma_welcome]
autoload=false

[Module-kded_plasma_welcome]
autoload=false
KDED_RC
cat > /etc/xdg/plasma-welcomerc << WELCOME_RC
[General]
LastSeenVersion=99.0.0
WELCOME_RC

# Keyboard shortcuts come from X-KDE-Shortcuts in these menu files.
# Meta (Windows key) and Alt+F1 open the Start menu, and Meta+V opens
# clipboard history (Klipper); both are SonicDE defaults.
cat > /usr/share/applications/sona-orca-restart.desktop << ORCA_RESTART
[Desktop Entry]
Type=Application
Name=Restart Orca
Comment=Restart the Orca screen reader (Alt+Windows+S)
Exec=orca --replace
Icon=orca
Terminal=false
Categories=Utility;Accessibility;
X-KDE-Shortcuts=Meta+Alt+S
ORCA_RESTART

# 13. Install yay and AUR packages (Chrome, Pamac, Thorium, RHVoice, OCR tools)
progress "Installing extra apps from the AUR, like Google Chrome. This can take a while."
# AUR problems must never stop the install, so every step here is allowed to fail.
if [[ "$INSTALL_AUR" == "y" && "$ONLINE" != y ]]; then
    echo "No internet: skipping AUR apps (Google Chrome, Pamac, Thorium, RHVoice). Firefox is the web browser."
    echo "Install them later with: yay -S google-chrome pamac-aur thorium-reader-bin rhvoice"
elif [[ "$INSTALL_AUR" == "y" ]]; then
echo "%wheel ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/99-sona-temp-nopasswd
chmod 0440 /etc/sudoers.d/99-sona-temp-nopasswd
if su - "$USERNAME" -c "rm -rf /tmp/yay-bin && git clone https://aur.archlinux.org/yay-bin.git /tmp/yay-bin && cd /tmp/yay-bin && makepkg -si --noconfirm"; then
    for aur_pkg in google-chrome tgpt-bin pamac-aur thorium-reader-bin ocrmypdf lios-git abcde rhvoice; do
        su - "$USERNAME" -c "yay -S --noconfirm --needed $aur_pkg" || echo "Warning: AUR package $aur_pkg skipped."
    done
else
    echo "Warning: yay could not be installed, so AUR packages were skipped."
    echo "You can install them later with: yay -S google-chrome pamac-aur thorium-reader-bin"
fi
rm -rf /tmp/yay-bin
rm -f /etc/sudoers.d/99-sona-temp-nopasswd
else
    echo "Skipping AUR packages (INSTALL_AUR=no)."
fi

# 14. Built-in Sona AI Assistant (Alt+Super+H / Copilot Key)
cat > /usr/local/bin/sona-ai << 'SONA_AI_SCRIPT'
#!/bin/bash
echo "====================================================="
echo " Welcome to the Sona Linux AI Assistant"
echo " Type any question about Sona Linux, SonicDE, or Orca."
echo " Type 'exit' or press Ctrl+C to close."
echo "====================================================="

SYS_PROMPT="You are the built-in helper for Sona Linux, an accessible Arch Linux distribution for blind users running the SonicDE desktop (an X11 fork of KDE Plasma), XLibre, and the Orca screen reader. Pressing the Windows (Super) key or Alt+F1 opens the Start menu. All main apps are also right on the Desktop: the web browser (Google Chrome or Firefox), Thunderbird Email (3-pane QuickMail layout using F6/Shift+F6), Add or Remove Software (Pamac), Word Processor (LibreOffice), Thorium Book Reader, VLC Media Player, Instant Screen OCR (Alt+Super+O), Clipboard History (Super+V), and System Restore (Timeshift). Files opens with Super+E and the terminal with Ctrl+Alt+T. Keep answers concise, plain-text, and focused on keyboard shortcuts."

while true; do
    printf "\nAsk Sona: "
    read -r user_query
    if [[ -z "$user_query" ]]; then
        continue
    fi
    if [[ "${user_query,,}" == "exit" || "${user_query,,}" == "quit" ]]; then
        break
    fi
    echo "Thinking..."
    tgpt -q --preprompt "$SYS_PROMPT" "$user_query" 2>/dev/null || echo "Unable to reach AI service. Check your internet connection."
done
SONA_AI_SCRIPT
chmod +x /usr/local/bin/sona-ai

# Shift+Meta+F23 is the Copilot key; Shift+Meta+XF86TouchpadOff is what
# some laptops send for it.
cat > /usr/share/applications/sona-ai.desktop << SONA_AI_DESKTOP
[Desktop Entry]
Type=Application
Name=Sona AI Assistant
Comment=Ask questions and get help using Sona Linux
Exec=konsole -p tabtitle="Sona AI Assistant" -e /usr/local/bin/sona-ai
Icon=utilities-terminal
Terminal=false
Categories=Utility;Accessibility;
X-KDE-Shortcuts=Meta+Alt+H,Meta+Shift+F23,Meta+Shift+TouchpadOff
SONA_AI_DESKTOP

# 15. NVDA-Style Instant Window OCR Tool (Alt+Super+O)
cat > /usr/local/bin/sona-ocr << 'SONA_OCR_SCRIPT'
#!/bin/bash
spd-say "Recognizing window, please wait" 2>/dev/null || true
TMP_IMG=$(mktemp /tmp/sona-ocr-XXXXXX.png)
TMP_TXT=$(mktemp /tmp/sona-ocr-XXXXXX.txt)

ACTIVE_WIN=$(xdotool getactivewindow 2>/dev/null || true)
if [[ -n "$ACTIVE_WIN" ]]; then
    maim --window "$ACTIVE_WIN" "$TMP_IMG" 2>/dev/null || maim "$TMP_IMG"
else
    maim "$TMP_IMG"
fi

tesseract "$TMP_IMG" stdout -l eng 2>/dev/null > "$TMP_TXT" || true

if [[ -s "$TMP_TXT" ]]; then
    xclip -selection clipboard < "$TMP_TXT" 2>/dev/null || true
    zenity --text-info --title="Sona Instant OCR (Copied to Clipboard - Press Escape to Close)" --width=700 --height=500 --filename="$TMP_TXT" 2>/dev/null || true
else
    spd-say "No text recognized in the current window" 2>/dev/null || true
    zenity --info --title="Sona Instant OCR" --text="No readable text was detected in the current window." 2>/dev/null || true
fi

rm -f "$TMP_IMG" "$TMP_TXT"
SONA_OCR_SCRIPT
chmod +x /usr/local/bin/sona-ocr

cat > /usr/share/applications/sona-ocr.desktop << SONA_OCR_DESKTOP
[Desktop Entry]
Type=Application
Name=Instant Screen OCR
Comment=Recognize text in the active window and read it with Orca
Exec=/usr/local/bin/sona-ocr
Icon=scanner
Terminal=false
Categories=Utility;Accessibility;
X-KDE-Shortcuts=Meta+Alt+O
SONA_OCR_DESKTOP

# SonicDE only registers X-KDE-Shortcuts from menu files linked into
# /usr/share/kglobalaccel, so link Sona's own.
mkdir -p /usr/share/kglobalaccel
for app in sona-orca-restart sona-ai sona-ocr; do
    ln -sfn "/usr/share/applications/$app.desktop" "/usr/share/kglobalaccel/$app.desktop"
done

# 16. Populate Desktop Icons for User and /etc/skel (Ready for Live ISO too)
progress "Adding desktop icons and default apps."
# Google Chrome comes from the AUR (step 13). Without it (no internet, or
# the AUR step skipped), Firefox is the web browser.
if pacman -Q google-chrome >/dev/null 2>&1; then
    BROWSER_NAME="Google Chrome" BROWSER_CMD=google-chrome-stable BROWSER_ICON=google-chrome BROWSER_APP=google-chrome.desktop
else
    BROWSER_NAME="Firefox" BROWSER_CMD=firefox BROWSER_ICON=firefox BROWSER_APP=firefox.desktop
fi
echo "BROWSER=$BROWSER_CMD" >> /etc/environment

create_desktop_shortcuts() {
    local target_dir="$1"
    mkdir -p "$target_dir"

    cat > "$target_dir/$BROWSER_NAME.desktop" << EOF_ICON
[Desktop Entry]
Type=Application
Name=$BROWSER_NAME
Comment=Browse the web
Exec=$BROWSER_CMD %U
Icon=$BROWSER_ICON
Terminal=false
EOF_ICON

    cat > "$target_dir/Thunderbird Email.desktop" << 'EOF_ICON'
[Desktop Entry]
Type=Application
Name=Thunderbird Email
Comment=Read and send email
Exec=thunderbird %u
Icon=thunderbird
Terminal=false
EOF_ICON

    cat > "$target_dir/Add or Remove Software.desktop" << 'EOF_ICON'
[Desktop Entry]
Type=Application
Name=Add or Remove Software
Comment=Install, update, and search for applications
Exec=pamac-manager
Icon=system-software-install
Terminal=false
EOF_ICON

    cat > "$target_dir/Sona AI Assistant.desktop" << 'EOF_ICON'
[Desktop Entry]
Type=Application
Name=Sona AI Assistant
Comment=Ask questions about Sona Linux and Orca shortcuts (Alt+Super+H)
Exec=konsole -p tabtitle="Sona AI Assistant" -e /usr/local/bin/sona-ai
Icon=utilities-terminal
Terminal=false
EOF_ICON

    cat > "$target_dir/Instant Screen OCR.desktop" << 'EOF_ICON'
[Desktop Entry]
Type=Application
Name=Instant Screen OCR
Comment=Read text from inaccessible images or windows (Alt+Super+O)
Exec=/usr/local/bin/sona-ocr
Icon=scanner
Terminal=false
EOF_ICON

    cat > "$target_dir/Word Processor.desktop" << 'EOF_ICON'
[Desktop Entry]
Type=Application
Name=Word Processor
Comment=Create and edit documents with LibreOffice Writer
Exec=libreoffice --writer %U
Icon=libreoffice-writer
Terminal=false
EOF_ICON

    cat > "$target_dir/Spreadsheet.desktop" << 'EOF_ICON'
[Desktop Entry]
Type=Application
Name=Spreadsheet
Comment=Create and edit spreadsheets with LibreOffice Calc
Exec=libreoffice --calc %U
Icon=libreoffice-calc
Terminal=false
EOF_ICON

    cat > "$target_dir/Thorium Book Reader.desktop" << 'EOF_ICON'
[Desktop Entry]
Type=Application
Name=Thorium Book Reader
Comment=Read BARD, Bookshare, DAISY, and EPUB books
Exec=thorium-reader %U
Icon=thorium-reader
Terminal=false
EOF_ICON

    cat > "$target_dir/OCR Document Scanner (LIOS).desktop" << 'EOF_ICON'
[Desktop Entry]
Type=Application
Name=OCR Document Scanner (LIOS)
Comment=Scan paper documents and PDFs into readable text
Exec=lios
Icon=scanner
Terminal=false
EOF_ICON

    cat > "$target_dir/VLC Media Player.desktop" << 'EOF_ICON'
[Desktop Entry]
Type=Application
Name=VLC Media Player
Comment=Play audio and video files
Exec=vlc %U
Icon=vlc
Terminal=false
EOF_ICON

    cat > "$target_dir/CD Ripper.desktop" << 'EOF_ICON'
[Desktop Entry]
Type=Application
Name=CD Ripper
Comment=Rip audio CDs with Sound Juicer
Exec=sound-juicer %u
Icon=org.gnome.SoundJuicer
Terminal=false
EOF_ICON

    cat > "$target_dir/Sound and Volume Control.desktop" << 'EOF_ICON'
[Desktop Entry]
Type=Application
Name=Sound and Volume Control
Comment=Adjust speaker, headphone, and microphone levels
Exec=pavucontrol
Icon=multimedia-volume-control
Terminal=false
EOF_ICON

    cat > "$target_dir/Bluetooth Devices.desktop" << 'EOF_ICON'
[Desktop Entry]
Type=Application
Name=Bluetooth Devices
Comment=Pair and manage Bluetooth speakers, headphones, and keyboards
Exec=systemsettings kcm_bluetooth
Icon=bluetooth
Terminal=false
EOF_ICON

    cat > "$target_dir/System Restore (Timeshift).desktop" << 'EOF_ICON'
[Desktop Entry]
Type=Application
Name=System Restore (Timeshift)
Comment=Create or restore system backup snapshots
Exec=timeshift-launcher
Icon=timeshift
Terminal=false
EOF_ICON

    chmod +x "$target_dir"/*.desktop
}

create_desktop_shortcuts "/home/$USERNAME/Desktop"
create_desktop_shortcuts "/etc/skel/Desktop"

# 17. Set the web browser (Chrome or Firefox) and Thunderbird as default applications
mkdir -p /etc/xdg "/home/$USERNAME/.config"
cat > /etc/xdg/mimeapps.list << MIMEAPPS
[Default Applications]
text/html=$BROWSER_APP
x-scheme-handler/http=$BROWSER_APP
x-scheme-handler/https=$BROWSER_APP
x-scheme-handler/about=$BROWSER_APP
x-scheme-handler/unknown=$BROWSER_APP
x-scheme-handler/mailto=thunderbird.desktop
message/rfc822=thunderbird.desktop

[Added Associations]
text/html=$BROWSER_APP;
x-scheme-handler/http=$BROWSER_APP;
x-scheme-handler/https=$BROWSER_APP;
x-scheme-handler/mailto=thunderbird.desktop;
message/rfc822=thunderbird.desktop;
MIMEAPPS

cp /etc/xdg/mimeapps.list "/home/$USERNAME/.config/mimeapps.list"

# 18. First-login helper: desktop icons, volume, login sound, XP theme
progress "Setting up Orca Bridge, Kokoro voices, and first-login settings."
if [[ "$XP_THEME" == "y" && -d /root/sona-extras/xp-theme ]]; then
    # Packages the Windows XP sound scripts need. The sounds themselves are
    # downloaded from archive.org at first login (see sona-session-init).
    install_optional "${SONA_XP_PKGS[@]}"
    mkdir -p /usr/share/sona /etc/sona
    rm -rf /usr/share/sona/xp-theme
    cp -r /root/sona-extras/xp-theme /usr/share/sona/xp-theme
    find /usr/share/sona/xp-theme -name '*.sh' -exec chmod 755 {} +
    install -m755 /usr/share/sona/xp-theme/sona-xp-firstrun /usr/local/bin/sona-xp-firstrun
    # Sounds included in a private build of the ISO (never in public builds).
    if [[ -d /root/sona-extras/xp-sounds ]]; then
        rm -rf /usr/share/sona/xp-sounds
        cp -r /root/sona-extras/xp-sounds /usr/share/sona/xp-sounds
    fi
    touch /etc/sona/xp-theme
fi

# Orca extensions, installed and approved for this user and for every user
# made later (/etc/skel): Orca Bridge (NVDA Remote-compatible remote
# access) and wine-access (Windows programs in Wine, if it is installed).
if [[ -f /root/sona-extras/orca-bridge/remote.orca-ext ]]; then
    mkdir -p /usr/share/sona
    rm -rf /usr/share/sona/orca-bridge
    cp -r /root/sona-extras/orca-bridge /usr/share/sona/orca-bridge
    install -m755 /usr/share/sona/orca-bridge/sona-orca-extensions /usr/local/bin/sona-orca-extensions
    sona-orca-extensions /etc/skel || echo "Warning: the Orca extensions could not be set up in /etc/skel."
    sona-orca-extensions "/home/$USERNAME" "$USERNAME" || echo "Warning: the Orca extensions could not be set up for $USERNAME."
fi

# Kokoro neural voices, an extra Speech Dispatcher synthesizer
# ("kokoro-generic"). On the Sona ISO the model is already in
# /opt/kokoro-speechd; otherwise it is downloaded now (about 350 MB).
if [[ -x /root/sona-extras/kokoro/sona-kokoro-setup ]]; then
    mkdir -p /usr/share/sona
    rm -rf /usr/share/sona/kokoro
    cp -r /root/sona-extras/kokoro /usr/share/sona/kokoro
    install -m755 /usr/share/sona/kokoro/sona-kokoro-setup /usr/local/bin/sona-kokoro-setup
    sona-kokoro-setup || echo "Warning: Kokoro voices could not be set up now. Run: sudo sona-kokoro-setup"
fi

progress "Building the OpenEVV voice from source. This takes a few minutes."
# OpenEVV (IBM ViaVoice / Eloquence), the default voice. Its language data
# is IBM's, so it is built here from source rather than shipped. The timer
# retries at every boot until it works (for installs with no internet) and
# then checks for updates weekly.
if [[ -f /root/sona-extras/packages/openevv-git/PKGBUILD ]]; then
    mkdir -p /usr/share/sona/packages
    rm -rf /usr/share/sona/packages/openevv-git
    cp -r /root/sona-extras/packages/openevv-git /usr/share/sona/packages/openevv-git
    install -m755 /usr/share/sona/packages/openevv-git/sona-openevv-update /usr/local/bin/sona-openevv-update
    install -m644 /usr/share/sona/packages/openevv-git/sona-openevv-update.service \
        /usr/share/sona/packages/openevv-git/sona-openevv-update.timer /etc/systemd/system/
    systemctl enable sona-openevv-update.timer
    sona-openevv-update || echo "Warning: OpenEVV could not be built now. It will be built automatically once this computer is online."
fi
rm -rf /root/sona-extras

cat > /usr/local/bin/sona-session-init << 'SESSION_INIT'
#!/bin/bash
for f in "$HOME"/Desktop/*.desktop; do
    [[ -f "$f" ]] || continue
    chmod +x "$f" 2>/dev/null || true
done
# Keep Sona's Orca extensions (Orca Bridge, wine-access) approved, for
# example after a package update changed their files.
if [[ -x /usr/local/bin/sona-orca-extensions ]]; then
    /usr/local/bin/sona-orca-extensions --refresh >/dev/null 2>&1 &
fi
# First login only: new sound devices start at a quiet 40% in WirePlumber,
# so raise the output to 70% and unmute it. Later logins keep whatever
# volume the user chose.
if [[ ! -f "$HOME/.config/sona/volume-set" ]]; then
    for _ in $(seq 1 20); do
        if wpctl inspect @DEFAULT_AUDIO_SINK@ >/dev/null 2>&1; then
            wpctl set-mute @DEFAULT_AUDIO_SINK@ 0
            wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.7
            mkdir -p "$HOME/.config/sona"
            touch "$HOME/.config/sona/volume-set"
            break
        fi
        sleep 0.5
    done
fi
# Windows XP theme, if chosen during install: set up once, in the
# background (it may need to wait for the internet to download the sounds).
# The XP helpers play their own startup and logon sounds from then on.
if [[ -f /etc/sona/xp-theme && -x /usr/local/bin/sona-xp-firstrun ]]; then
    if [[ ! -f "$HOME/.config/sona/xp-theme-installed" ]]; then
        /usr/local/bin/sona-xp-firstrun >/dev/null 2>&1 &
        paplay /usr/share/sounds/freedesktop/stereo/service-login.oga 2>/dev/null &
    fi
    exit 0
fi
paplay /usr/share/sounds/freedesktop/stereo/service-login.oga 2>/dev/null &
SESSION_INIT
chmod +x /usr/local/bin/sona-session-init

cat > /etc/xdg/autostart/sona-session-init.desktop << DESKTOP
[Desktop Entry]
Type=Application
Name=Sona Desktop Session Init
Exec=/usr/local/bin/sona-session-init
OnlyShowIn=KDE;
X-KDE-autostart-phase=2
DESKTOP

if [[ "$SERIAL_CONSOLE" == "y" ]]; then
    # Automated install test only: copy the journal to the serial port and
    # log a line once SonicDE has started, so the test can see the desktop.
    mkdir -p /etc/systemd/journald.conf.d
    cat > /etc/systemd/journald.conf.d/50-sona-serial.conf << JOURNAL_SERIAL
[Journal]
ForwardToConsole=yes
TTYPath=/dev/ttyS0
MaxLevelConsole=info
JOURNAL_SERIAL
    cat > /etc/xdg/autostart/sona-ci-desktop.desktop << CI_DESKTOP
[Desktop Entry]
Type=Application
Name=Sona install test marker
Exec=logger -t sona-ci "SONA-CI: DESKTOP STARTED"
OnlyShowIn=KDE;
X-KDE-autostart-phase=2
CI_DESKTOP
fi

chown -R "$USERNAME:$USERNAME" "/home/$USERNAME"

# 19. Refresh the boot menu now that everything is installed, so it also
progress "Finishing the boot menu."
# lists Windows or other systems found by os-prober. GRUB itself was
# installed earlier, so a failure here still leaves a bootable system.
[[ "$QUICK_TEST" == "y" ]] || grub-mkconfig -o /boot/grub/grub.cfg || echo "Warning: could not refresh the GRUB menu. Run grub-mkconfig -o /boot/grub/grub.cfg after reboot."
EOF

chmod +x /mnt/root/setup-chroot.sh

# Sona extras: Orca Bridge, the Kokoro setup, Sona's PKGBUILDs (OpenEVV),
# and the Windows XP theme kit (if chosen). From the Sona live ISO if they
# are there, otherwise downloaded from the Sona repository on GitHub. A
# problem here never stops the install.
rm -rf /mnt/root/sona-extras
mkdir -p /mnt/root/sona-extras
if [[ -d /usr/share/sona/orca-bridge ]]; then
    for extra in orca-bridge kokoro packages xp-theme xp-sounds; do
        [[ -d "/usr/share/sona/$extra" ]] && cp -r "/usr/share/sona/$extra" /mnt/root/sona-extras/
    done
elif ! curl -fsSL "https://github.com/chasecichorz/sona/archive/refs/heads/main.tar.gz" |
        tar -xz --strip-components=1 -C /mnt/root/sona-extras \
            sona-main/orca-bridge sona-main/kokoro sona-main/packages sona-main/xp-theme; then
    echo "Warning: could not download Sona's extras (Orca Bridge, Kokoro, OpenEVV, XP theme), so they were skipped."
fi
[[ "$XP_THEME" == "y" ]] || rm -rf /mnt/root/sona-extras/xp-theme /mnt/root/sona-extras/xp-sounds

step "Setting up the new system" "Starting."
# The setup script prints "@@STEP text" at each part; those update the
# status box, and everything goes to the log.
# (The exit code goes through a file: a failing pipeline would otherwise
# trigger the error trap before it could be read.)
rc_file=$(mktemp)
{ arch-chroot /mnt /root/setup-chroot.sh; echo $? > "$rc_file"; } 2>&1 | tee -a "$LOG" | while IFS= read -r line; do
    if [[ "$line" == "@@STEP "* ]]; then
        show_progress "Setting up the new system" "${line#@@STEP }"
    elif [[ "$QUIET" != yes ]]; then
        printf '%s\n' "$line"
    fi
done || true
chroot_rc=$(cat "$rc_file" 2>/dev/null || echo 1)
rm -f "$rc_file"
if [[ "$chroot_rc" -ne 0 ]]; then
    err "Setting up the new system failed (exit code $chroot_rc)."
fi

rm -f /mnt/root/setup-chroot.sh /mnt/root/install.conf
# Keep the install log on the new system. It has no passwords in it.
cp "$LOG" /mnt/var/log/sona-install.log 2>/dev/null || true

step "Finishing" "Unmounting the new system."
umount -R /mnt
MOUNTED=false

if [[ "$UNATTENDED" == yes ]]; then
    case "$(ans FINISH reboot)" in
        reboot)   echo "Sona Linux has been installed. Rebooting."; reboot ;;
        poweroff) echo "Sona Linux has been installed. Powering off."; poweroff ;;
        none)     echo "Sona Linux has been installed." ;;
        *)        echo "Sona Linux has been installed. (Unknown FINISH value; not rebooting.)" ;;
    esac
    exit 0
fi

ui_msg "Installation Complete" "Sona Linux has been installed! Remove your installation media and press Enter to reboot."
reboot

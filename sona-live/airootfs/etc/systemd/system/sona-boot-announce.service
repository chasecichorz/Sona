[Unit]
Description=Say out loud that Sona Linux is starting
# Runs once the sound card is ready and before the desktop takes it over,
# so a blind user knows the computer is working during the silent wait.
After=sound.target livecd-alsa-unmuter.service
Before=display-manager.service
ConditionKernelCommandLine=!sona.console

[Service]
Type=oneshot
ExecStart=/usr/bin/espeak-ng -s 165 "Sona Linux is starting. The desktop and the Orca screen reader will be ready in about a minute."
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
